<UserControl x:Class="NasaAstronautTraining.Views.LaunchpadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1280"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- ================= TASARIM TOKENLARI ================= -->
        <SolidColorBrush x:Key="BgBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="InkBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#475569" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#64748B" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BlueDarkBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#EFF5FF" />
        <SolidColorBrush x:Key="RedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="RedSoftBrush" Color="#FDECEC" />

        <FontFamily x:Key="HeadFont">Bahnschrift</FontFamily>
        <FontFamily x:Key="TechFont">Bahnschrift Condensed, Bahnschrift</FontFamily>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.08" Color="#0F172A" />
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#0F172A" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ================= SELÇUKLU 8 KÖŞELİ YILDIZ DESENİ (KÜÇÜLTÜLMÜŞ & ZARİF) ================= -->
        <DrawingBrush x:Key="SeljukStarTile"
                      TileMode="Tile"
                      Viewport="0,0,36,36" ViewportUnits="Absolute"
                      Viewbox="0,0,100,100" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <!-- şeffaf taban (karo boyutunu sabitler) -->
                    <GeometryDrawing Brush="#00FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,100,100" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- karo bağlantı çizgileri -->
                    <GeometryDrawing Geometry="M50,19 L50,0 M81,50 L100,50 M50,81 L50,100 M19,50 L0,50
                                               M28,28 L0,0 M72,28 L100,0 M72,72 L100,100 M28,72 L0,100">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#A4BBDC" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <!-- 8 köşeli yıldız: iç içe geçmiş iki kare -->
                    <GeometryDrawing Brush="#10336FCC"
                                     Geometry="M28,28 L72,28 L72,72 L28,72 Z M50,19 L81,50 L50,81 L19,50 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#92ACD4" Thickness="1.5" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <!-- merkez sekizgen göz -->
                    <GeometryDrawing Brush="#162563EB"
                                     Geometry="M50,38 L58.5,41.5 L62,50 L58.5,58.5 L50,62 L41.5,58.5 L38,50 L41.5,41.5 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#A4BBDC" Thickness="1.0" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Giriş ekranı alt kısmı ile birebir uyumlu Türk motifi döşemesi -->
        <ImageBrush x:Key="TurkMotifTileBrush"
                    ImageSource="pack://application:,,,/DORA;component/Assets/turk-motif.png"
                    TileMode="Tile"
                    Viewport="0,0,270,234"
                    ViewportUnits="Absolute"
                    Stretch="Fill" />

        <!-- Güneş paneli dokusu -->
        <DrawingBrush x:Key="SolarPanelBrush" TileMode="Tile" Viewport="0,0,24,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#2F62D4">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,8" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#6B97F0">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,7,24,1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ================= STİLLER ================= -->
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <!-- Yuvarlak ok butonu -->
        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="White" Stroke="#E2E8F0" StrokeThickness="1.2"
                                     Effect="{StaticResource SoftShadow}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Stroke" Value="#2563EB" />
                                <Setter TargetName="bg" Property="Fill" Value="#EFF5FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#DCE8FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sade ikon butonu (tam ekran) -->
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EAF1FE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dil seçimi butonu -->
        <Style x:Key="LangButtonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LangTrButton" TargetType="Button" BasedOn="{StaticResource LangButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnglish}" Value="False">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LangEnButton" TargetType="Button" BasedOn="{StaticResource LangButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Kırmızı ana aksiyon butonu -->
        <Style x:Key="PrimaryRedButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="29"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E23B3B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C93030" />
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rol karosu -->
        <Style x:Key="RoleTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="112" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="White" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="16">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path x:Name="icon" Style="{StaticResource IconPath}" Data="{Binding Icon}"
                                      Width="36" Height="36" Stroke="#475569" StrokeThickness="1.9"
                                      HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock x:Name="label" Text="{Binding Title}"
                                           FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="16"
                                           Foreground="#0F172A" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#B8CCF5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="bg" Property="Background" Value="#EFF5FF" />
                                <Setter TargetName="icon" Property="Stroke" Value="#1D4ED8" />
                                <Setter TargetName="label" Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Çağrı adı giriş kutusu -->
        <Style x:Key="CallSignBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="MaxLength" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bg" Background="White" BorderBrush="#D5DEEA" BorderThickness="1.5"
                                CornerRadius="14" Height="56" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- astronot kaskı ikonu -->
                                <Path Style="{StaticResource IconPath}" Width="24" Height="24" Stroke="#64748B"
                                      Margin="0,0,12,0" VerticalAlignment="Center"
                                      Data="M12,3 A8,8 0 0 1 20,11 V17 A2,2 0 0 1 18,19 H6 A2,2 0 0 1 4,17 V11 A8,8 0 0 1 12,3 Z M7.5,9.5 H16.5 V13.5 A2,2 0 0 1 14.5,15.5 H9.5 A2,2 0 0 1 7.5,13.5 Z M4,21 H20" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="TeleLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TechFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TeleValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TechFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="TeleSep" TargetType="Ellipse">
            <Setter Property="Width" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Fill" Value="#94A3B8" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <!-- Arka Plan: Beyaz / Açık Uzay Merkezli Temiz Gradyan (Giriş Sayfası İle Birebir Aynı) -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F8FAFC" Offset="0.0" />
                <GradientStop Color="#F1F5F9" Offset="0.5" />
                <GradientStop Color="#E2E8F0" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Alt Yarı: Türk Motifi Dokusu (Giriş Sayfası İle Birebir Aynı) -->
        <Border VerticalAlignment="Bottom"
                Height="340"
                Opacity="1.0"
                IsHitTestVisible="False">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0.0" />
                    <GradientStop Color="#50FFFFFF" Offset="0.25" />
                    <GradientStop Color="#C0FFFFFF" Offset="0.70" />
                    <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Grid>
                <Border Background="#1E3A8A" OpacityMask="{StaticResource TurkMotifTileBrush}" />
                <Border Background="#1E3A8A" OpacityMask="{StaticResource TurkMotifTileBrush}" />
            </Grid>
        </Border>

        <!-- ================= ORTALANMIŞ ANA SAHNE (TÜM SAYFALARLA BİREBİR AYNI BOYUT VE ÖLÇEK: 1500PX) ================= -->
        <Grid MaxWidth="1500" Margin="32,20,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= ÜST BAR ================= -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/DORA;component/Assets/altay-tunga-amblem.png"
                           Width="58" Height="58" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ALTAY TUNGA DORA" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                   FontSize="28" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding AppSubtitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="1,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostIconButton}" Click="ToggleFullscreen_Click" ToolTip="Tam ekran"
                            Width="46" Height="46" Margin="0,0,10,0">
                        <Path Style="{StaticResource IconPath}" Width="19" Height="19" Stroke="#0F172A" StrokeThickness="2"
                              Data="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15" />
                    </Button>
                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2"
                            CornerRadius="23" Padding="4" Height="46" Effect="{StaticResource SoftShadow}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="TR" Style="{StaticResource LangTrButton}" Width="46" Height="38" FontSize="17"
                                    Command="{Binding SetLanguageCommand}" CommandParameter="TR" />
                            <Button Content="EN" Style="{StaticResource LangEnButton}" Width="46" Height="38" FontSize="17"
                                    Command="{Binding SetLanguageCommand}" CommandParameter="EN" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= ANA İÇERİK ================= -->
            <Grid Grid.Row="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="560" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="480" />
                </Grid.ColumnDefinitions>

                <!-- ============ SOL SÜTUN ============ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. KUTUSUZ HOŞ GELDİN VE SERBEST UZAY İLLÜSTRASYONU (UYDU + ROKET) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Kutusuz Karşılama Alanı -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Background="#E6EEFC" CornerRadius="8" Padding="14,6" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding RankText}" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                           FontSize="18" Foreground="{StaticResource BlueDarkBrush}" />
                            </Border>
                            <TextBlock Text="{Binding WelcomeText}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                       FontSize="52" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding AccountName}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                       FontSize="40" Foreground="{StaticResource BlueBrush}" Margin="0,-2,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="460" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SubWelcomeText}" FontFamily="Segoe UI" FontWeight="SemiBold"
                                       FontSize="19" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" LineHeight="26" MaxWidth="460" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Serbest Uzay Sahnesi: Dünya + ISS + Yükselen Vektör Roket -->
                        <Viewbox Grid.Column="1" Width="330" Height="215" Stretch="Uniform" IsHitTestVisible="False">
                            <Canvas Width="420" Height="280">
                                <!-- Yörünge Yayı -->
                                <Ellipse Canvas.Left="20" Canvas.Top="70" Width="380" Height="140"
                                         Stroke="#9DBEF3" StrokeThickness="1.6" StrokeDashArray="3 4" Opacity="0.85">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-14" CenterX="190" CenterY="70" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- Roket Yükseliş İzi (Dashed Trajectory) -->
                                <Path Stroke="#EF4444" StrokeThickness="1.8" StrokeDashArray="2 3" Opacity="0.75"
                                      Data="M50,260 Q130,190 200,90" />

                                <!-- Dünya Küresi -->
                                <Grid Canvas.Left="120" Canvas.Top="35" Width="240" Height="240">
                                    <Grid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF000000" Offset="0.55" />
                                            <GradientStop Color="#00000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Grid.OpacityMask>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.4,0.38" RadiusX="0.7" RadiusY="0.7">
                                                <GradientStop Color="#F4F8FF" Offset="0" />
                                                <GradientStop Color="#C9DDFB" Offset="0.55" />
                                                <GradientStop Color="#8FB6F2" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Kıtalar -->
                                    <Path Fill="#A9C7F5" Opacity="0.75"
                                          Data="M48,70 C68,55 98,58 106,75 C116,92 94,102 86,114 C76,132 56,124 48,106 C42,92 36,80 48,70 Z
                                                M140,48 C165,40 195,58 200,78 C205,100 185,98 170,108 C158,118 146,102 142,88 C138,72 128,55 140,48 Z
                                                M126,140 C146,130 170,145 175,165 C178,185 156,200 140,192 C124,185 112,156 126,140 Z">
                                        <Path.Clip>
                                            <EllipseGeometry Center="120,120" RadiusX="120" RadiusY="120" />
                                        </Path.Clip>
                                    </Path>
                                    <Ellipse Stroke="#FFFFFF" StrokeThickness="2" Opacity="0.6" />
                                </Grid>

                                <!-- Bulutlar -->
                                <Path Canvas.Left="290" Canvas.Top="60" Fill="White" Opacity="0.95"
                                      Data="M0,16 A9,9 0 0 1 14,6 A13,13 0 0 1 36,4 A9,9 0 0 1 48,16 Z" />
                                <Path Canvas.Left="105" Canvas.Top="200" Fill="White" Opacity="0.9"
                                      Data="M0,16 A10,10 0 0 1 15,7 A14,14 0 0 1 40,5 A10,10 0 0 1 54,16 Z" />

                                <!-- ISS Maketi (Hafifçe Süzülen) -->
                                <Canvas x:Name="IssCanvas" Canvas.Left="135" Canvas.Top="45" Width="220" Height="120">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="-16" CenterX="110" CenterY="60" />
                                            <TranslateTransform x:Name="IssFloat" Y="0" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <Canvas.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetName="IssFloat"
                                                                     Storyboard.TargetProperty="Y"
                                                                     From="0" To="-8" Duration="0:0:3.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Canvas.Triggers>

                                    <!-- Ana kiriş -->
                                    <Rectangle Canvas.Left="8" Canvas.Top="57" Width="204" Height="6"
                                               Fill="#DCE3EC" Stroke="#64748B" StrokeThickness="1" />
                                    <!-- Güneş panelleri -->
                                    <Rectangle Canvas.Left="20" Canvas.Top="4" Width="24" Height="51" Fill="{StaticResource SolarPanelBrush}" Stroke="#1E3A8A" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="50" Canvas.Top="4" Width="24" Height="51" Fill="{StaticResource SolarPanelBrush}" Stroke="#1E3A8A" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="20" Canvas.Top="65" Width="24" Height="51" Fill="{StaticResource SolarPanelBrush}" Stroke="#1E3A8A" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="50" Canvas.Top="65" Width="24" Height="51" Fill="{StaticResource SolarPanelBrush}" Stroke="#1E3A8A" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="146" Canvas.Top="4" Width="24" Height="51" Fill="{StaticResource SolarPanelBrush}" Stroke="#1E3A8A" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="176" Canvas.Top="4" Width="24" Height="51" Fill="{StaticResource SolarPanelBrush}" Stroke="#1E3A8A" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="146" Canvas.Top="65" Width="24" Height="51" Fill="{StaticResource SolarPanelBrush}" Stroke="#1E3A8A" StrokeThickness="1" />
                                    <Rectangle Canvas.Left="176" Canvas.Top="65" Width="24" Height="51" Fill="{StaticResource SolarPanelBrush}" Stroke="#1E3A8A" StrokeThickness="1" />
                                    <!-- Modüller -->
                                    <Rectangle Canvas.Left="100" Canvas.Top="28" Width="20" Height="64" RadiusX="6" RadiusY="6"
                                               Fill="White" Stroke="#64748B" StrokeThickness="1.2" />
                                    <Rectangle Canvas.Left="84" Canvas.Top="49" Width="52" Height="22" RadiusX="7" RadiusY="7"
                                               Fill="White" Stroke="#64748B" StrokeThickness="1.2" />
                                    <Rectangle Canvas.Left="92" Canvas.Top="76" Width="36" Height="9"
                                               Fill="#F1F5F9" Stroke="#94A3B8" StrokeThickness="1" />
                                    <Ellipse Canvas.Left="106" Canvas.Top="56" Width="8" Height="8" Fill="#2563EB" />
                                </Canvas>

                                <!-- Yükselen Vektör Roket (T-10 Fırlatma Hissi) -->
                                <Canvas Canvas.Left="180" Canvas.Top="60" Width="60" Height="80">
                                    <Canvas.RenderTransform>
                                        <RotateTransform Angle="34" CenterX="30" CenterY="40" />
                                    </Canvas.RenderTransform>
                                    <!-- Roket gövdesi -->
                                    <Path Fill="White" Stroke="#0F172A" StrokeThickness="1.6"
                                          Data="M30,5 C36,15 39,35 39,52 H21 C21,35 24,15 30,5 Z" />
                                    <!-- Burun konisi (Kırmızı) -->
                                    <Path Fill="#EF4444"
                                          Data="M30,5 C34,14 36,22 36,22 H24 C24,22 26,14 30,5 Z" />
                                    <!-- Sol Kanat (Kırmızı) -->
                                    <Path Fill="#EF4444" Stroke="#0F172A" StrokeThickness="1.4"
                                          Data="M21,38 L12,54 H21 Z" />
                                    <!-- Sağ Kanat (Kırmızı) -->
                                    <Path Fill="#EF4444" Stroke="#0F172A" StrokeThickness="1.4"
                                          Data="M39,38 L48,54 H39 Z" />
                                    <!-- Lumbuz Penceresi -->
                                    <Ellipse Canvas.Left="26.5" Canvas.Top="28" Width="7" Height="7" Fill="#2563EB" Stroke="#0F172A" StrokeThickness="1.2" />
                                    <!-- Roket Alevi (Exhaust Plume) -->
                                    <Path Fill="#F59E0B" Stroke="#EF4444" StrokeThickness="1"
                                          Data="M24,53 Q30,72 36,53 Q30,62 24,53 Z" />
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <!-- 2. ÜÇLÜ GÖREV VE TELEMETRİ METRİK KUTULARI -->
                    <UniformGrid Grid.Row="2" Columns="3">
                        <!-- Kutu 1: Yörünge Hızı -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1.2" CornerRadius="18" Padding="18,14" Margin="0,0,7,0"
                                Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding SpeedLabel}" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                               FontSize="17" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                                    <Path Style="{StaticResource IconPath}" Width="19" Height="19" Stroke="{StaticResource BlueBrush}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M12,2.5 C15.5,5.5 16.5,10 15,15 H9 C7.5,10 8.5,5.5 12,2.5 Z M9,15 L6,18.5 H9.5 M15,15 L18,18.5 H14.5 M10.5,18.5 L12,21.5 L13.5,18.5" />
                                </Grid>
                                <TextBlock FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="31" Foreground="{StaticResource BlueDarkBrush}">
                                    <Run Text="{Binding IssSpeed, Mode=OneWay}" /><Run Text=" KM/S" FontSize="20" />
                                </TextBlock>
                                <TextBlock Text="{Binding SpeedSub}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Kutu 2: Yörünge İrtifası -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1.2" CornerRadius="18" Padding="18,14" Margin="3.5,0"
                                Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding OrbitLabel}" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                               FontSize="17" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                                    <Path Style="{StaticResource IconPath}" Width="19" Height="19" Stroke="{StaticResource BlueBrush}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M12,3 A9,9 0 1 1 3,12 A9,9 0 0 1 12,3 Z M3,12 H21 M12,3 A13,13 0 0 1 12,21 A13,13 0 0 1 12,3" />
                                </Grid>
                                <TextBlock Text="408 KM" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="31" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="{Binding OrbitSub}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Kutu 3: Telemetri & Canlı Saat -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1.2" CornerRadius="18" Padding="18,14" Margin="7,0,0,0"
                                Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding ClockLabel}" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                               FontSize="17" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                                    <Ellipse Width="10" Height="10" Fill="#22C55E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding MissionClock}" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="31" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource TechFont}" FontSize="15.5" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 3. MİNİMAL VE SABİT EBATLI BİLİYOR MUYDUN? KARTI -->
                    <Grid Grid.Row="4" Width="570" Height="142" HorizontalAlignment="Left">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1.2" CornerRadius="18" Margin="22,0" Padding="24,14,20,12"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel VerticalAlignment="Center">
                                <Grid x:Name="FactContent" Height="78">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="FactSlide" />
                                    </Grid.RenderTransform>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Bilgi Rozeti ve Metni -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Border Background="{StaticResource RedBrush}" CornerRadius="12" Padding="13,4"
                                                HorizontalAlignment="Left" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding FactBadge}" FontFamily="{StaticResource HeadFont}"
                                                       FontWeight="Bold" FontSize="15" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding FactText}" FontFamily="Segoe UI" FontWeight="SemiBold"
                                                   FontSize="19" Foreground="{StaticResource InkBrush}"
                                                   TextWrapping="Wrap" LineHeight="25" Height="50"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Konu İkonu -->
                                    <Path Grid.Column="1" Style="{StaticResource IconPath}" Data="{Binding CurrentFact.Icon}"
                                          Width="52" Height="52" Stroke="{StaticResource BlueBrush}" StrokeThickness="2.2"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0,8,0" />
                                </Grid>

                                <!-- Sayfalama Noktaları (Sabit Konumda) -->
                                <ItemsControl ItemsSource="{Binding FactDots}" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="7.5" CornerRadius="3.75" Margin="3.5,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Width" Value="7.5" />
                                                        <Setter Property="Background" Value="#CBD5E1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Width" Value="24" />
                                                                <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Önceki / Sonraki Dairesel Butonlar -->
                        <Button Style="{StaticResource CircleButton}" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Command="{Binding PreviousFactCommand}" ToolTip="Önceki">
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Stroke="#0F172A" StrokeThickness="2.4"
                                  Data="M15,5 L8,12 L15,19" />
                        </Button>
                        <Button Style="{StaticResource CircleButton}" Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding NextFactCommand}" ToolTip="Sonraki">
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Stroke="#0F172A" StrokeThickness="2.4"
                                  Data="M9,5 L16,12 L9,19" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- ============ SAĞ SÜTUN: BİNİŞ KARTI (BÜYÜTÜLMÜŞ & GÜÇLÜ) ============ -->
                <Border Grid.Column="2" VerticalAlignment="Center" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2" CornerRadius="24"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- Kart başlığı -->
                        <Grid Margin="30,24,30,14">
                            <StackPanel>
                                <TextBlock Text="{Binding BoardingTitle}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                           FontSize="34" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="GATE 01" FontFamily="{StaticResource TechFont}" FontSize="17.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="1,2,0,0" />
                            </StackPanel>
                            <Border Background="#EEF2F7" CornerRadius="9" Padding="14,5" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,3,0,0">
                                <TextBlock Text="DORA-26" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                           FontSize="17" Foreground="{StaticResource InkBrush}" />
                            </Border>
                        </Grid>

                        <!-- Delikli koparma çizgisi ve içe kavisli çentikler -->
                        <Grid Height="24" ClipToBounds="True">
                            <Line X1="0" X2="1" Stretch="Fill" VerticalAlignment="Center" Margin="22,0"
                                  Stroke="#CBD5E1" StrokeThickness="1.6" StrokeDashArray="4 3" />
                            <Path HorizontalAlignment="Left" Fill="{StaticResource BgBrush}" Stroke="{StaticResource LineBrush}"
                                  StrokeThickness="1.2" Data="M0,0 A12,12 0 0 1 0,24" />
                            <Path HorizontalAlignment="Right" Fill="{StaticResource BgBrush}" Stroke="{StaticResource LineBrush}"
                                  StrokeThickness="1.2" Data="M12,0 A12,12 0 0 0 12,24" />
                        </Grid>

                        <!-- Biniş Formu -->
                        <StackPanel Margin="30,16,30,26">
                            <TextBlock Text="{Binding CallSignLabel}" Style="{StaticResource FieldLabel}" FontSize="18" />
                            <TextBox Style="{StaticResource CallSignBox}" Height="54" FontSize="20"
                                     Text="{Binding CallSign, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding CallSignError}" Foreground="{StaticResource RedBrush}" FontSize="15"
                                       FontWeight="SemiBold" Margin="4,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CallSignError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource FieldLabel}" FontSize="18" Margin="0,18,0,10" />
                            <ItemsControl ItemsSource="{Binding Roles}" Margin="-4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource RoleTile}" Height="116" GroupName="LaunchpadRole"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     Command="{Binding DataContext.SelectRoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource PrimaryRedButton}" Height="58" Margin="0,24,0,0"
                                    Command="{Binding StartMissionCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StartText}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                               FontSize="22" Foreground="White" VerticalAlignment="Center" />
                                    <Path Style="{StaticResource IconPath}" Width="22" Height="22" Stroke="White" StrokeThickness="2"
                                          Margin="10,0,0,0" VerticalAlignment="Center"
                                          Data="M12,2.5 C15.5,5.5 16.5,10 15,15 H9 C7.5,10 8.5,5.5 12,2.5 Z M9,15 L6,18.5 H9.5 M15,15 L18,18.5 H14.5 M10.5,18.5 L12,21.5 L13.5,18.5 M13.6,9 A1.6,1.6 0 1 1 10.4,9 A1.6,1.6 0 1 1 13.6,9 Z">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="40" CenterX="12" CenterY="12" />
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
