<UserControl x:Class="NasaAstronautTraining.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:NasaAstronautTraining.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1280"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

        <SolidColorBrush x:Key="InkBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#475569" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#64748B" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BlueDarkBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="RedBrush" Color="#EF4444" />

        <FontFamily x:Key="HeadFont">Bahnschrift</FontFamily>
        <FontFamily x:Key="TechFont">Bahnschrift Condensed, Bahnschrift</FontFamily>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.09" Color="#0F172A" />
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#0F172A" />

        <!-- Kullanıcının Belirlediği Türk Motifi Arka Plan Dokusu -->
        <ImageBrush x:Key="TurkMotifTileBrush"
                    ImageSource="pack://application:,,,/DORA;component/Assets/turk-motif.png"
                    TileMode="Tile"
                    Viewport="0,0,270,234"
                    ViewportUnits="Absolute"
                    Opacity="1.0" />

        <!-- Güneş paneli dokusu -->
        <DrawingBrush x:Key="SolarPanelBrush" TileMode="Tile" Viewport="0,0,24,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#2F62D4">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,8" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#6B97F0">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,7,24,1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <!-- Üst Bar Eşit Boyutlu (46px) İkon/Kapsül Butonu -->
        <Style x:Key="HeaderBarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="23" Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource SoftShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hızlı Profil Seçim Kapsülü -->
        <Style x:Key="QuickProfilePill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.4"
                                CornerRadius="12" Padding="12,7" Margin="0,0,8,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Roket Kırmızısı Ana Giriş Butonu -->
        <Style x:Key="LaunchButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#EF4444" CornerRadius="29" RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Color="#EF4444" Opacity="0.35" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Arka Plan: Beyaz / Açık Uzay Merkezli Temiz Gradyan -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F8FAFC" Offset="0.0" />
                <GradientStop Color="#F1F5F9" Offset="0.5" />
                <GradientStop Color="#E2E8F0" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Alt Yarı: Türk Motifi Dokusu (Tüm Ekranlarda Birebir Aynı) -->
        <Border VerticalAlignment="Bottom"
                Height="340"
                Opacity="1.0"
                IsHitTestVisible="False">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0.0" />
                    <GradientStop Color="#50FFFFFF" Offset="0.25" />
                    <GradientStop Color="#C0FFFFFF" Offset="0.70" />
                    <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Grid>
                <Border Background="#1E3A8A" OpacityMask="{StaticResource TurkMotifTileBrush}" />
                <Border Background="#1E3A8A" OpacityMask="{StaticResource TurkMotifTileBrush}" />
            </Grid>
        </Border>

        <!-- ================= ORTALANMIŞ ANA SAHNE (TÜM SAYFALARLA BİREBİR AYNI ÖLÇEK: 1500PX) ================= -->
        <Grid MaxWidth="1500" Margin="32,20,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Üst Menü Çubuğu -->
                <RowDefinition Height="25" />   <!-- Üst Menü ile İçerik Arası 25px Padding -->
                <RowDefinition Height="*" />    <!-- Ana İçerik -->
            </Grid.RowDefinitions>

            <!-- ================= 1. ÜST BAR (HOŞ GELDİNİZ VE ANA EKRAN İLE BİREBİR AYNI BOYUT) ================= -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/DORA;component/Assets/altay-tunga-amblem.png"
                           Width="58" Height="58" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ALTAY TUNGA DORA" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                   FontSize="28" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Genç Astronot Akademisi" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="1,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Sağ: Eşit Boyutlu (46px) Tam Ekran + Dil Seçici -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderBarButton}" Click="ToggleFullscreen_Click" ToolTip="Tam Ekran"
                            Width="46" Height="46" Margin="0,0,10,0">
                        <Path Style="{StaticResource IconPath}" Width="19" Height="19" Stroke="#0F172A" StrokeThickness="2"
                              Data="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15" />
                    </Button>

                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2"
                            CornerRadius="23" Padding="4" Height="46" Effect="{StaticResource SoftShadow}">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="LanguageButton_Click" Width="46" Height="38" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource BlueBrush}" CornerRadius="19">
                                            <TextBlock Text="{Binding SelectedLanguage}" FontFamily="{StaticResource TechFont}"
                                                       FontWeight="Bold" FontSize="17" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="LanguageButton_Click" Width="46" Height="38" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="19">
                                            <TextBlock Text="EN" FontFamily="{StaticResource TechFont}"
                                                       FontWeight="Bold" FontSize="17" Foreground="{StaticResource SubtleBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= 2. ANA İÇERİK (HOŞ GELDİNİZ SAYFASI UI TASARIMINDA) ================= -->
            <Grid Grid.Row="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="560" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="510" />
                </Grid.ColumnDefinitions>

                <!-- ============ SOL SÜTUN: KUTUSUZ KARŞILAMA, UYDU/ROKET SAHNESİ & 3'LÜ ÖZET KUTULARI ============ -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Kutusuz Karşılama & Uzay İllüstrasyonu -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border Background="#E6EEFC" CornerRadius="10" Padding="14,6" HorizontalAlignment="Left">
                                <TextBlock Text="ASTRONOT AKADEMİSİ GİRİŞ KAPISI" FontFamily="{StaticResource TechFont}"
                                           FontWeight="Bold" FontSize="17" Foreground="{StaticResource BlueDarkBrush}" />
                            </Border>
                            <TextBlock Text="Hoş geldin!" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                       FontSize="52" Foreground="{StaticResource InkBrush}" Margin="0,10,0,0" />
                            <TextBlock Text="Uzay Görev Komutası" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                       FontSize="36" Foreground="{StaticResource BlueBrush}" Margin="0,-2,0,0" />
                            <TextBlock Text="Çağrı adını ve güvenlik kodunu girerek biniş kartını oluştur, 6 aşamalı yörünge simülasyonuna ve NASA eğitim modüllerine bağlan."
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" LineHeight="25" Margin="0,10,0,0" MaxWidth="460" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Sağda Yörünge Uydusu & Roket İllüstrasyonu -->
                        <Viewbox Grid.Column="1" Width="280" Height="220" Stretch="Uniform" VerticalAlignment="Center">
                            <Canvas Width="310" Height="240">
                                <Ellipse Canvas.Left="58" Canvas.Top="18" Width="195" Height="195">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.38,0.32" GradientOrigin="0.35,0.3" RadiusX="0.65" RadiusY="0.65">
                                            <GradientStop Color="#DCEBFF" Offset="0" />
                                            <GradientStop Color="#9EC2FA" Offset="0.62" />
                                            <GradientStop Color="#009EC2FA" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <Path Data="M 16,152 A 148,46 0 1 1 296,96" Stroke="#94A3B8" StrokeThickness="1.5" StrokeDashArray="4,4" />

                                <!-- Uydu -->
                                <Canvas Canvas.Left="76" Canvas.Top="54" Width="160" Height="110" RenderTransformOrigin="0.5,0.5">
                                    <Canvas.RenderTransform>
                                        <RotateTransform Angle="-14" />
                                    </Canvas.RenderTransform>
                                    <Border Canvas.Left="0" Canvas.Top="14" Width="54" Height="82" CornerRadius="4"
                                            BorderBrush="#1E3A8A" BorderThickness="1.8" Background="{StaticResource SolarPanelBrush}" />
                                    <Rectangle Canvas.Left="54" Canvas.Top="52" Width="14" Height="5" Fill="#64748B" />
                                    <Border Canvas.Left="66" Canvas.Top="32" Width="28" Height="46" CornerRadius="5"
                                            Background="#F1F5F9" BorderBrush="#334155" BorderThickness="1.8" />
                                    <Rectangle Canvas.Left="94" Canvas.Top="52" Width="14" Height="5" Fill="#64748B" />
                                    <Border Canvas.Left="106" Canvas.Top="14" Width="54" Height="82" CornerRadius="4"
                                            BorderBrush="#1E3A8A" BorderThickness="1.8" Background="{StaticResource SolarPanelBrush}" />
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <!-- 2. Üçlü Akademi Özet Kutuları (LaunchpadView İle Aynı Tasarım) -->
                    <UniformGrid Grid.Row="2" Columns="3">
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                                CornerRadius="18" Padding="18,14" Margin="0,0,8,0" Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <TextBlock Text="YÖRÜNGE ROTASI" FontFamily="{StaticResource TechFont}" FontSize="15"
                                           FontWeight="Bold" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock Text="6 Görev Aşaması" FontFamily="{StaticResource HeadFont}" FontSize="21"
                                           FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                                CornerRadius="18" Padding="18,14" Margin="4,0,4,0" Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <TextBlock Text="KRİZ SİMÜLASYONU" FontFamily="{StaticResource TechFont}" FontSize="15"
                                           FontWeight="Bold" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock Text="24 Olasılık" FontFamily="{StaticResource HeadFont}" FontSize="21"
                                           FontWeight="Bold" Foreground="{StaticResource BlueBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                                CornerRadius="18" Padding="18,14" Margin="8,0,0,0" Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <TextBlock Text="AKADEMİ &amp; HANGAR" FontFamily="{StaticResource TechFont}" FontSize="15"
                                           FontWeight="Bold" Foreground="{StaticResource SubtleBrush}" />
                                <TextBlock Text="5 Eğitim • 8 Oyun" FontFamily="{StaticResource HeadFont}" FontSize="21"
                                           FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 3. Alt Telemetri Durum Kapsülü -->
                    <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                            CornerRadius="18" Padding="20,12" HorizontalAlignment="Left" Effect="{StaticResource SoftShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ISS HIZI: " FontFamily="{StaticResource TechFont}" FontSize="16" Foreground="#64748B" />
                            <TextBlock Text="27.600 KM/S" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="17" Foreground="#0F172A" Margin="0,0,16,0" />
                            <TextBlock Text="YÖRÜNGE: " FontFamily="{StaticResource TechFont}" FontSize="16" Foreground="#64748B" />
                            <TextBlock Text="408 KM" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="17" Foreground="#0F172A" Margin="0,0,16,0" />
                            <TextBlock Text="DURUM: SİSTEM HAZIR" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="17" Foreground="#16A34A" Margin="0,0,8,0" />
                            <Ellipse Width="10" Height="10" Fill="#22C55E" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ SAĞ SÜTUN: BİNİŞ KARTI STİLİNDE ASTRONOT GİRİŞ KARTI ============ -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5"
                        CornerRadius="28" Padding="32,26" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- Kart Başlığı -->
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="ASTRONOT GİRİŞ KARTI" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                           FontSize="27" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="GATE 01 • GÜVENLİ KOMUTA GİRİŞİ" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                           FontSize="16" Foreground="{StaticResource SubtleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#EEF2F7" CornerRadius="10" Padding="13,6">
                                <TextBlock Text="DORA-26" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                           FontSize="16" Foreground="#334155" />
                            </Border>
                        </Grid>

                        <!-- Biniş Kartı Kesikli Ayırıcı -->
                        <Rectangle Height="1.5" Margin="0,14,0,14" Stroke="#CBD5E1" StrokeThickness="1.5" StrokeDashArray="4,4" />

                        <!-- Kayıtlı / Hazır Astronot Adayları -->
                        <TextBlock Text="KAYITLI ASTRONOT ADAYLARI (HIZLI SEÇİM)" FontFamily="{StaticResource HeadFont}"
                                   FontWeight="Bold" FontSize="16" Foreground="#0F172A" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,12">
                            <Button Style="{StaticResource QuickProfilePill}" Click="QuickUser_Click" Tag="Artemis Adayı:1969">
                                <TextBlock Text="Artemis Adayı" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" Foreground="#1D4ED8" />
                            </Button>
                            <Button Style="{StaticResource QuickProfilePill}" Click="QuickUser_Click" Tag="Neil Armstrong:1969">
                                <TextBlock Text="Neil Armstrong" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" Foreground="#1D4ED8" />
                            </Button>
                            <Button Style="{StaticResource QuickProfilePill}" Click="QuickUser_Click" Tag="Alper Gezeravcı:1969">
                                <TextBlock Text="Alper Gezeravcı" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" Foreground="#1D4ED8" />
                            </Button>
                        </WrapPanel>

                        <!-- Çağrı Adı / Kullanıcı Adı -->
                        <TextBlock Text="ÇAĞRI ADIN (KULLANICI ADI)" FontFamily="{StaticResource HeadFont}"
                                   FontWeight="Bold" FontSize="17" Foreground="#0F172A" Margin="0,0,0,6" />
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="14" Height="52" Padding="14,0" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource IconPath}" Width="22" Height="22" Stroke="#2563EB" Margin="0,0,12,0" VerticalAlignment="Center"
                                      Data="M12,3 A8,8 0 0 1 20,11 V17 A2,2 0 0 1 18,19 H6 A2,2 0 0 1 4,17 V11 A8,8 0 0 1 12,3 Z M7.5,9.5 H16.5 V13.5 A2,2 0 0 1 14.5,15.5 H9.5 A2,2 0 0 1 7.5,13.5 Z" />
                                <TextBox x:Name="AstronautNameBox" Grid.Column="1"
                                         Text="{Binding AstronautName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="19" FontWeight="SemiBold" Foreground="#0F172A"
                                         Background="Transparent" BorderThickness="0" CaretBrush="#2563EB"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Şifre -->
                        <TextBlock Text="GÜVENLİK KODU (ŞİFRE)" FontFamily="{StaticResource HeadFont}"
                                   FontWeight="Bold" FontSize="17" Foreground="#0F172A" Margin="0,0,0,6" />
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="14" Height="52" Padding="14,0" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource IconPath}" Width="21" Height="21" Stroke="#2563EB" Margin="0,0,12,0" VerticalAlignment="Center"
                                      Data="M7,11 V8 A5,5 0 0 1 17,8 V11 M5,11 H19 V20 H5 Z" />
                                <PasswordBox x:Name="SecretCodeBox" Grid.Column="1"
                                             PasswordChanged="SecretCodeBox_PasswordChanged"
                                             FontSize="19" Foreground="#0F172A"
                                             Background="Transparent" BorderThickness="0" CaretBrush="#2563EB"
                                             VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Şifre Güç Göstergesi -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0" Value="{Binding PasswordStrengthValue}" Maximum="100" Height="6"
                                         Background="#E2E8F0" Foreground="{Binding PasswordStrengthColor}"
                                         BorderThickness="0" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Text="{Binding PasswordStrengthLabel}"
                                       Foreground="{Binding PasswordStrengthColor}"
                                       FontSize="15" FontWeight="SemiBold" />
                        </Grid>

                        <!-- Hata / Durum Mesajları -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="16" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

                        <TextBlock Text="{Binding StatusMessage}" Foreground="#16A34A" FontSize="16" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />

                        <!-- Giriş Yap Butonu -->
                        <Button Style="{StaticResource LaunchButtonStyle}" Click="LoginButton_Click" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="GİRİŞ YAP &amp; KOKPİTE GEÇ" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="Bold" FontSize="19" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Path Style="{StaticResource IconPath}" Width="22" Height="22" Stroke="White" StrokeThickness="2.2"
                                      Data="M14,10 L19.5,4.5 C20,7.5 18.5,11 16,13.5 L12.5,17 L7,11.5 L10.5,8 C13,5.5 16.5,4 19.5,4.5" />
                            </StackPanel>
                        </Button>

                        <!-- Kayıt Ol Butonu -->
                        <Button Click="RegisterButton_Click" Height="46" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="regBd" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="14">
                                        <TextBlock Text="Yeni Astronot Adayı Kaydı Oluştur" FontFamily="{StaticResource HeadFont}"
                                                   FontWeight="Bold" FontSize="16.5" Foreground="#1D4ED8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="regBd" Property="Background" Value="#DBEAFE" />
                                            <Setter TargetName="regBd" Property="BorderBrush" Value="#2563EB" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
