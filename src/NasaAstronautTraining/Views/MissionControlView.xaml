<UserControl x:Class="NasaAstronautTraining.Views.MissionControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:converters="clr-namespace:NasaAstronautTraining.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1280"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- ================= RENK & TİPOGRAFİ TOKENLARI ================= -->
        <SolidColorBrush x:Key="BgBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="InkBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#475569" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#64748B" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BlueDarkBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#EFF5FF" />
        <SolidColorBrush x:Key="RedBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="RedDarkBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="GreenBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F59E0B" />

        <FontFamily x:Key="HeadFont">Bahnschrift</FontFamily>
        <FontFamily x:Key="TechFont">Bahnschrift Condensed, Bahnschrift</FontFamily>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.07" Color="#0F172A" />
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#0F172A" />
        <DropShadowEffect x:Key="GlowBlue" BlurRadius="18" ShadowDepth="0" Color="#2563EB" Opacity="0.45" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- Giriş ekranı alt kısmı ile birebir uyumlu Türk motifi döşemesi -->
        <ImageBrush x:Key="TurkMotifTileBrush"
                    ImageSource="pack://application:,,,/DORA;component/Assets/turk-motif.png"
                    TileMode="Tile"
                    Viewport="0,0,270,234"
                    ViewportUnits="Absolute"
                    Stretch="Fill" />

        <!-- ================= ORTAK STİLLER ================= -->
        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <!-- Navigasyon Sekme Buton Stili -->
        <Style x:Key="NavTabButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Roket Kırmızısı Aksiyon Butonu -->
        <Style x:Key="PrimaryRedButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{StaticResource RedBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="18,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#EF4444" Opacity="0.32" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RedDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mavi İkincil Aksiyon Butonu -->
        <Style x:Key="SecondaryBlueButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#EFF5FF" />
            <Setter Property="Foreground" Value="{StaticResource BlueDarkBrush}" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Test Seçenek Butonu -->
        <Style x:Key="QuizOptionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1.4" CornerRadius="14" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- İkon Buton (Ghost) -->
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="23" Effect="{StaticResource SoftShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dil Butonu Seçim Tetikleyicileri -->
        <Style x:Key="LangTrButton" TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource TechFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnglish}" Value="False">
                    <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LangEnButton" TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource TechFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= YÖRÜNGE HARİTASI DİNAMİK AŞAMA DÜĞÜMÜ STİLİ ================= -->
        <Style x:Key="OrbitStageNodeButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Üst Rozet: Kazanılan Madalya veya Seçili Etiketi -->
                            <Border x:Name="topPill" Visibility="Collapsed"
                                    Background="#2563EB" BorderBrush="White" BorderThickness="1.2"
                                    CornerRadius="8" Padding="8,2" Margin="0,0,0,4"
                                    HorizontalAlignment="Center" Effect="{StaticResource SoftShadow}">
                                <TextBlock x:Name="topPillText" Text="SEÇİLİ GÖREV"
                                           FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                           FontSize="13.5" Foreground="White" />
                            </Border>

                            <!-- Dairesel Görev Düğümü -->
                            <Grid Width="58" Height="58" HorizontalAlignment="Center">
                                <!-- Seçili Halo Halkası -->
                                <Ellipse x:Name="haloRing" Width="58" Height="58"
                                         Fill="#222563EB" Stroke="#2563EB" StrokeThickness="2"
                                         StrokeDashArray="3,2" Visibility="Collapsed" />

                                <!-- Ana Daire -->
                                <Ellipse x:Name="mainCircle" Width="46" Height="46"
                                         Fill="#FFFFFF" Stroke="#64748B" StrokeThickness="2.6"
                                         Effect="{StaticResource SoftShadow}" />

                                <!-- Aşama Numarası (Varsayılan / Aktif) -->
                                <TextBlock x:Name="numText" Text="{Binding NumberBadge}"
                                           FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                           FontSize="18.5" Foreground="#1E293B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Tamamlandı Onay İkonu -->
                                <Path x:Name="checkIcon" Visibility="Collapsed"
                                      Style="{StaticResource IconPath}" Width="20" Height="20"
                                      Stroke="White" StrokeThickness="2.8"
                                      Data="M5,12.5 L10,17.5 L19,7.5" />
                            </Grid>

                            <!-- Alt Bilgi Kartı -->
                            <Border x:Name="labelCard" Background="White" BorderBrush="#CBD5E1"
                                    BorderThickness="1.4" CornerRadius="11" Padding="10,4"
                                    Margin="0,4,0,0" Effect="{StaticResource SoftShadow}">
                                <StackPanel>
                                    <TextBlock x:Name="titleText" Text="{Binding ShortName}"
                                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                               FontSize="14.5" Foreground="#0F172A" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="statusText" Text="{Binding StatusText}"
                                               FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                               FontSize="12.5" Foreground="#475569" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <!-- Aktif Aşama -->
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="mainCircle" Property="Fill" Value="#2563EB" />
                                <Setter TargetName="mainCircle" Property="Stroke" Value="White" />
                                <Setter TargetName="numText" Property="Foreground" Value="White" />
                                <Setter TargetName="statusText" Property="Foreground" Value="#2563EB" />
                                <Setter TargetName="labelCard" Property="BorderBrush" Value="#93C5FD" />
                            </DataTrigger>

                            <!-- Bu Turda Tamamlanan Aşama -->
                            <DataTrigger Binding="{Binding IsRoundCompleted}" Value="True">
                                <Setter TargetName="mainCircle" Property="Fill" Value="#16A34A" />
                                <Setter TargetName="mainCircle" Property="Stroke" Value="White" />
                                <Setter TargetName="numText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="checkIcon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="statusText" Property="Foreground" Value="#16A34A" />
                                <Setter TargetName="labelCard" Property="BorderBrush" Value="#86EFAC" />
                                <Setter TargetName="labelCard" Property="Background" Value="#F0FDF4" />
                            </DataTrigger>

                            <!-- Madalya Kazanılmışsa Üst Rozeti Göster -->
                            <DataTrigger Binding="{Binding HasMedal}" Value="True">
                                <Setter TargetName="topPill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="topPill" Property="Background" Value="#F59E0B" />
                                <Setter TargetName="topPillText" Property="Text" Value="{Binding MedalShortText}" />
                            </DataTrigger>

                            <!-- Seçili Aşama Vurgusu -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="haloRing" Property="Visibility" Value="Visible" />
                                <Setter TargetName="mainCircle" Property="Width" Value="50" />
                                <Setter TargetName="mainCircle" Property="Height" Value="50" />
                                <Setter TargetName="mainCircle" Property="Effect" Value="{StaticResource GlowBlue}" />
                                <Setter TargetName="labelCard" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="labelCard" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="labelCard" Property="BorderThickness" Value="2" />
                                <Setter TargetName="titleText" Property="Foreground" Value="#1D4ED8" />
                                <Setter TargetName="topPill" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- Mouse Üzerindeyken -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="haloRing" Property="Visibility" Value="Visible" />
                                <Setter TargetName="labelCard" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <!-- Giriş Ekranı ile Birebir Aynı Gökyüzü Arka Plan Gradyanı -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                <GradientStop Color="#F8FAFC" Offset="0" />
                <GradientStop Color="#F1F5F9" Offset="0.6" />
                <GradientStop Color="#E2E8F0" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Giriş Ekranı İle Birebir Aynı Alt Türk Motifi Katmanı -->
        <Grid Height="340" VerticalAlignment="Bottom" IsHitTestVisible="False"
              RenderOptions.BitmapScalingMode="HighQuality">
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.0" />
                    <GradientStop Color="#35000000" Offset="0.22" />
                    <GradientStop Color="#B0000000" Offset="0.58" />
                    <GradientStop Color="#FF000000" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Border Background="#1E3A8A" OpacityMask="{StaticResource TurkMotifTileBrush}" />
            <Border Background="#1E3A8A" OpacityMask="{StaticResource TurkMotifTileBrush}" />
        </Grid>

        <!-- ================= ORTALANMIŞ ANA SAHNE (TÜM EKRANLARDA BİREBİR AYNI ÖLÇEK: 1500PX & 25PX PADDING) ================= -->
        <Grid MaxWidth="1500" Margin="32,20,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Üst Navigasyon Çubuğu -->
                <RowDefinition Height="25" />   <!-- Üst Menü İle İçerik Arasında 25px Padding -->
                <RowDefinition Height="*" />    <!-- Seçili Sekmenin İçeriği -->
            </Grid.RowDefinitions>

            <!-- ================= 1. ÜST NAVİGASYON ÇUBUĞU (HOŞ GELDİNİZ SAYFASI İLE BİREBİR AYNI BOYUT) ================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol: Logo & Amblem -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/DORA;component/Assets/altay-tunga-amblem.png"
                           Width="58" Height="58" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                   FontSize="28" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding AppSubtitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}" Margin="1,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Orta: 5 Sekmeli Navigasyon Kapsülü (46px Eşit Yükseklik) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"
                        Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2"
                        Height="46" CornerRadius="23" Padding="5,4" Effect="{StaticResource SoftShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- KOMUTA -->
                        <Button Content="{Binding TabKomuta}" Command="{Binding SelectTabCommand}" CommandParameter="KOMUTA">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKomutaTab}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- AKADEMİ -->
                        <Button Content="{Binding TabAkademi}" Command="{Binding SelectTabCommand}" CommandParameter="AKADEMİ">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAkademiTab}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- HANGAR -->
                        <Button Content="{Binding TabHangar}" Command="{Binding SelectTabCommand}" CommandParameter="HANGAR">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHangarTab}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- KÜNYE -->
                        <Button Content="{Binding TabKunye}" Command="{Binding SelectTabCommand}" CommandParameter="KÜNYE">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKunyeTab}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- AYARLAR -->
                        <Button Content="{Binding TabAyarlar}" Command="{Binding SelectTabCommand}" CommandParameter="AYARLAR">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAyarlarTab}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Sağ: Canlı Madalya Özeti + Astronot Profil Kapsülü + Tam Ekran + Dil (Ayarlar Dişlisi Kaldırıldı, Tüm Elemanlar 46px Eşit Boyutta) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Canlı Madalya Özeti Kapsülü (Height="46") -->
                    <Button Command="{Binding ShowMedalCelebrationCommand}"
                            Height="46" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,10,0"
                            ToolTip="Kazanılan Madalya Tablosunu Gör">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="medBd" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1.3"
                                        Height="46" CornerRadius="23" Padding="14,0" Effect="{StaticResource SoftShadow}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="#D97706" Fill="#F59E0B" Margin="0,0,6,0"
                                              Data="M12,2.5 L14.6,8 L20.5,8.8 L16.2,13 L17.3,19 L12,16.2 L6.7,19 L7.8,13 L3.5,8.8 L9.4,8 Z" />
                                        <TextBlock Text="{Binding TotalGoldCount, StringFormat='{}{0} Altın'}" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="15.5" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding TotalSilverCount, StringFormat='{}{0} Gümüş'}" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="15.5" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding TotalBronzeCount, StringFormat='{}{0} Bronz'}" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="15.5" Foreground="#9A3412" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="medBd" Property="Background" Value="#FEF3C7" />
                                        <Setter TargetName="medBd" Property="BorderBrush" Value="#F59E0B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Astronot Profil Kapsülü (Height="46") -->
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="KÜNYE"
                            Height="46" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,10,0" ToolTip="Astronot Künyesi ve Profilini Aç">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="profBd" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2"
                                        Height="46" CornerRadius="23" Padding="10,0,16,0" Effect="{StaticResource SoftShadow}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#EFF5FF"
                                                BorderBrush="{StaticResource BlueBrush}" BorderThickness="1.2" Margin="0,0,8,0">
                                            <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="{StaticResource BlueBrush}"
                                                  Data="M12,4 C8.5,4 6,6.5 6,10 C6,12.5 7.5,14.5 9.5,15.5 L9.5,18 H14.5 L14.5,15.5 C16.5,14.5 18,12.5 18,10 C18,6.5 15.5,4 12,4 Z M8.5,9.5 C8.5,8 10,7.5 12,7.5 C14,7.5 15.5,8 15.5,9.5 C15.5,11 14,12 12,12 C10,12 8.5,11 8.5,9.5 Z" />
                                        </Border>
                                        <TextBlock Text="{Binding AstronautRoleTitle}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                                   FontSize="16.5" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="profBd" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                                        <Setter TargetName="profBd" Property="Background" Value="#EFF6FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tam Ekran Butonu (Width="46" Height="46") -->
                    <Button Style="{StaticResource GhostIconButton}" Width="46" Height="46" Margin="0,0,10,0"
                            Click="OnToggleFullscreen" ToolTip="Tam Ekran">
                        <Path Style="{StaticResource IconPath}" Width="19" Height="19" Stroke="{StaticResource InkBrush}"
                              Data="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15" />
                    </Button>

                    <!-- TR / EN Dil Seçici (Height="46") -->
                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2"
                            CornerRadius="23" Padding="4" Height="46" Effect="{StaticResource SoftShadow}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="TR" Width="46" Height="38" Style="{StaticResource LangTrButton}"
                                    Command="{Binding SetLanguageCommand}" CommandParameter="TR" />
                            <Button Content="EN" Width="46" Height="38" Style="{StaticResource LangEnButton}"
                                    Command="{Binding SetLanguageCommand}" CommandParameter="EN" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ========================================================================================= -->
            <!-- ================= SEKME 1: KOMUTA (YÖRÜNGE HARİTASI + SİMÜLASYON KOKPİTİ) =============== -->
            <!-- ========================================================================================= -->
            <Grid Grid.Row="2" Visibility="{Binding IsKomutaTab, Converter={StaticResource BoolToVis}}">

                <!-- 1A. VARSAYILAN GÖRÜNÜM: GÖREV YÖRÜNGESİ & AŞAMALAR HARİTASI -->
                <Grid Visibility="{Binding IsStageCockpitActive, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- SOL SÜTUN: GÖREV YÖRÜNGESİ & 6 İNTERAKTİF AŞAMA KONTROL MERKEZİ -->
                    <Border Grid.Column="0" Background="#EBFFFFFF" BorderBrush="White" BorderThickness="1.8"
                            CornerRadius="26" Padding="22,18" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Başlık & Tüm Görevleri Yenile -->
                                <RowDefinition Height="*" />    <!-- Yörünge Haritası Tuvali -->
                                <RowDefinition Height="Auto" /> <!-- 6 Aşama Kartı & Hızlı Senaryo Yenileme Şeridi -->
                                <RowDefinition Height="Auto" /> <!-- Alt Telemetri & Durum Özeti -->
                            </Grid.RowDefinitions>

                            <!-- Üst Başlık + Tur Rozeti + Tüm Görevleri Yenile Butonu -->
                            <Grid Grid.Row="0" Margin="2,0,2,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MapTitle}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                                   FontSize="25" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                        <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.2"
                                                CornerRadius="8" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoundLevel, StringFormat='GÖREV TURU #{0}'}"
                                                       FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                                       FontSize="15" Foreground="#1D4ED8" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Düğümlere veya alt kartlara tıklayarak aşama seçin; yenile tuşuyla 4 farklı kriz olasılığını çözün."
                                               FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryBlueButton}" Height="38" Margin="0,0,8,0"
                                            Command="{Binding ShowMedalCelebrationCommand}" ToolTip="6 Aşama Madalya Tablosunu Göster">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="#D97706" Fill="#F59E0B" Margin="0,0,6,0"
                                                  Data="M12,2.5 L14.6,8 L20.5,8.8 L16.2,13 L17.3,19 L12,16.2 L6.7,19 L7.8,13 L3.5,8.8 L9.4,8 Z" />
                                            <TextBlock Text="Madalya Tablosu" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" Foreground="#1E3A8A" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource SecondaryBlueButton}" Height="38"
                                            Command="{Binding TumGorevleriYenileCommand}" ToolTip="Tüm 6 aşama için yeni kriz olasılıkları yükle ve sıfırla">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="#1D4ED8" StrokeThickness="2" Margin="0,0,6,0"
                                                  Data="M4,12 A8,8 0 0,1 18,6.7 M20,12 A8,8 0 0,1 6,17.3 M15,4 H19 V8 M9,20 H5 V16" />
                                            <TextBlock Text="Tümünü Yenile" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" Foreground="#1D4ED8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- İnteraktif Yörünge Haritası Tuvali -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2"
                                    CornerRadius="20" Margin="0,0,0,10" ClipToBounds="True">
                                <Viewbox Stretch="Uniform" StretchDirection="Both">
                                    <Canvas Width="760" Height="360">
                                        <!-- Arka Plan Yörünge Izgarası ve Halkaları -->
                                        <Ellipse Canvas.Left="18" Canvas.Top="155" Width="195" Height="195"
                                                 Stroke="#CBD5E1" StrokeThickness="1.4" StrokeDashArray="5,4" />
                                        <Ellipse Canvas.Left="-5" Canvas.Top="132" Width="240" Height="240"
                                                 Stroke="#E2E8F0" StrokeThickness="1.2" />

                                        <!-- Ana Yörünge Eğrisi (1 -> 2 -> 3 -> 4 -> 5 -> 6) -->
                                        <Path Data="M 115,255 C 145,175 190,130 240,125 C 295,120 330,195 385,190 C 440,185 465,100 515,95 C 565,90 585,205 630,210 C 675,215 685,115 690,72"
                                              Stroke="#93C5FD" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.45" />

                                        <Path Data="M 115,255 C 145,175 190,130 240,125 C 295,120 330,195 385,190 C 440,185 465,100 515,95 C 565,90 585,205 630,210 C 675,215 685,115 690,72"
                                              Stroke="#2563EB" StrokeThickness="3.2" StrokeDashArray="5,3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                        <!-- ================= GEZEGENLER (DÜNYA, AY, MARS, DERİN UZAY) ================= -->
                                        <!-- DÜNYA -->
                                        <Canvas Canvas.Left="42" Canvas.Top="182" Width="145" Height="145" IsHitTestVisible="False">
                                            <Ellipse Width="145" Height="145" Fill="#183B82F6" />
                                            <Ellipse Canvas.Left="12" Canvas.Top="12" Width="121" Height="121">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0.2,0.1" EndPoint="0.85,0.9">
                                                        <GradientStop Color="#60A5FA" Offset="0" />
                                                        <GradientStop Color="#2563EB" Offset="0.6" />
                                                        <GradientStop Color="#1D4ED8" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Path Canvas.Left="12" Canvas.Top="12" Fill="#6EE7B7" Opacity="0.78"
                                                  Data="M30,28 C44,20 58,26 62,38 C66,50 54,64 42,60 C30,56 20,38 30,28 Z M70,58 C82,52 98,62 96,76 C94,90 78,98 68,88 C60,80 62,64 70,58 Z" />
                                        </Canvas>

                                        <!-- AY -->
                                        <Canvas Canvas.Left="468" Canvas.Top="36" Width="84" Height="84" IsHitTestVisible="False">
                                            <Ellipse Width="84" Height="84" Fill="#1564748B" />
                                            <Ellipse Canvas.Left="8" Canvas.Top="8" Width="68" Height="68">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0.2,0.2" EndPoint="0.8,0.8">
                                                        <GradientStop Color="#F1F5F9" Offset="0" />
                                                        <GradientStop Color="#CBD5E1" Offset="0.65" />
                                                        <GradientStop Color="#94A3B8" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse Canvas.Left="24" Canvas.Top="22" Width="14" Height="14" Fill="#94A3B8" Opacity="0.45" />
                                            <Ellipse Canvas.Left="44" Canvas.Top="38" Width="16" Height="16" Fill="#94A3B8" Opacity="0.4" />
                                        </Canvas>

                                        <!-- MARS -->
                                        <Canvas Canvas.Left="580" Canvas.Top="145" Width="96" Height="96" IsHitTestVisible="False">
                                            <Ellipse Width="96" Height="96" Fill="#18EF4444" />
                                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="76" Height="76">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0.2,0.15" EndPoint="0.85,0.85">
                                                        <GradientStop Color="#FB923C" Offset="0" />
                                                        <GradientStop Color="#EA580C" Offset="0.55" />
                                                        <GradientStop Color="#B91C1C" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Canvas>

                                        <!-- DERİN UZAY HEDEF HALKASI -->
                                        <Canvas Canvas.Left="650" Canvas.Top="20" Width="74" Height="74" IsHitTestVisible="False">
                                            <Ellipse Width="74" Height="74" Stroke="#93C5FD" StrokeThickness="1.4" StrokeDashArray="3,3" />
                                            <Ellipse Canvas.Left="12" Canvas.Top="12" Width="50" Height="50" Fill="#EFF6FF" Stroke="#3B82F6" StrokeThickness="1.5" />
                                        </Canvas>

                                        <!-- ================= 6 DİNAMİK İNTERAKTİF AŞAMA DÜĞÜMÜ ================= -->
                                        <!-- DÜĞÜM 01 -->
                                        <Button Canvas.Left="68" Canvas.Top="210"
                                                Style="{StaticResource OrbitStageNodeButtonStyle}"
                                                DataContext="{Binding Stages[0]}"
                                                Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <!-- DÜĞÜM 02 -->
                                        <Button Canvas.Left="192" Canvas.Top="78"
                                                Style="{StaticResource OrbitStageNodeButtonStyle}"
                                                DataContext="{Binding Stages[1]}"
                                                Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <!-- DÜĞÜM 03 -->
                                        <Button Canvas.Left="335" Canvas.Top="142"
                                                Style="{StaticResource OrbitStageNodeButtonStyle}"
                                                DataContext="{Binding Stages[2]}"
                                                Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <!-- DÜĞÜM 04 -->
                                        <Button Canvas.Left="465" Canvas.Top="52"
                                                Style="{StaticResource OrbitStageNodeButtonStyle}"
                                                DataContext="{Binding Stages[3]}"
                                                Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <!-- DÜĞÜM 05 -->
                                        <Button Canvas.Left="578" Canvas.Top="165"
                                                Style="{StaticResource OrbitStageNodeButtonStyle}"
                                                DataContext="{Binding Stages[4]}"
                                                Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <!-- DÜĞÜM 06 -->
                                        <Button Canvas.Left="638" Canvas.Top="24"
                                                Style="{StaticResource OrbitStageNodeButtonStyle}"
                                                DataContext="{Binding Stages[5]}"
                                                Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- 6 Aşamalı İnteraktif Kartlar & Hızlı Olasılık Yenileme Şeridi (3x2 Grid) -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Stages}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" Rows="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="stageCardBd" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.4"
                                                CornerRadius="13" Padding="10,7" Margin="3" Effect="{StaticResource SoftShadow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Aşamayı Seçen Tıklanabilir Alan -->
                                                <Button Grid.Column="0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                        Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid Background="Transparent">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="numBadge" Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                                                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,8,0">
                                                                    <TextBlock x:Name="numTxt" Text="{Binding NumberBadge}"
                                                                               FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5"
                                                                               Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ShortName}" FontFamily="{StaticResource HeadFont}"
                                                                               FontWeight="Bold" FontSize="15.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock x:Name="stStatTxt" Text="{Binding StatusText}" FontFamily="{StaticResource TechFont}"
                                                                                   FontWeight="Bold" FontSize="13.5" Foreground="#64748B" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding MedalShortText}"
                                                                                   Visibility="{Binding HasMedal, Converter={StaticResource BoolToVis}}"
                                                                                   FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="13.5" Foreground="#D97706" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsRoundCompleted}" Value="True">
                                                                    <Setter TargetName="numBadge" Property="Background" Value="#DCFCE7" />
                                                                    <Setter TargetName="numBadge" Property="BorderBrush" Value="#86EFAC" />
                                                                    <Setter TargetName="numTxt" Property="Foreground" Value="#15803D" />
                                                                    <Setter TargetName="stStatTxt" Property="Foreground" Value="#16A34A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="numBadge" Property="Background" Value="#2563EB" />
                                                                    <Setter TargetName="numBadge" Property="BorderBrush" Value="#1D4ED8" />
                                                                    <Setter TargetName="numTxt" Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Sağda Hızlı Senaryo Olasılığı Yenile Butonu -->
                                                <Button Grid.Column="1" Width="30" Height="30" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                        Command="{Binding DataContext.YenileStageSenaryoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Bu aşama için 4 olasılıktan yeni bir kriz senaryosu yükle">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="refBd" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                                                                <Path Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="#2563EB" StrokeThickness="2"
                                                                      Data="M4,12 A8,8 0 0,1 18,6.7 M20,12 A8,8 0 0,1 6,17.3 M15,4 H19 V8 M9,20 H5 V16" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="refBd" Property="Background" Value="#DBEAFE" />
                                                                    <Setter TargetName="refBd" Property="BorderBrush" Value="#2563EB" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="stageCardBd" Property="BorderBrush" Value="#2563EB" />
                                                <Setter TargetName="stageCardBd" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="stageCardBd" Property="Background" Value="#EFF6FF" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Harita Alt Bilgi Şeridi (Dinamik Bağlantılı) -->
                            <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#CBD5E1"
                                    BorderThickness="1" CornerRadius="12" Padding="14,7">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding CompletedStagesCountText}" FontSize="15.5" FontWeight="Bold" Foreground="#15803D" Margin="0,0,18,0" />
                                        <Ellipse Width="9" Height="9" Fill="#2563EB" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding ActiveStageSummaryText}" FontSize="15.5" FontWeight="Bold" Foreground="#1D4ED8" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding CurrentScenarioNumberText}"
                                               FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="15.5" Foreground="#475569" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- SAĞ SÜTUN: 3 KOMUTA KARTI -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.38*" /> <!-- 1. Güncel Görev Brifingi -->
                            <RowDefinition Height="14" />
                            <RowDefinition Height="0.82*" /> <!-- 2. Astronot Gelişimi & Madalya Özeti -->
                            <RowDefinition Height="14" />
                            <RowDefinition Height="1.05*" /> <!-- 3. Günün Mini Testi -->
                        </Grid.RowDefinitions>

                        <!-- KART 1: GÜNCEL GÖREV BRİFİNGİ (SİMÜLASYON + OLASILIK YENİLE + EĞİTİM) -->
                        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2"
                                CornerRadius="22" Padding="22,18" Effect="{StaticResource CardShadow}">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BriefingHeading}" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="16.5" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                CornerRadius="7" Padding="8,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding CurrentScenarioNumberText}" FontFamily="{StaticResource TechFont}"
                                                       FontWeight="Bold" FontSize="14.5" Foreground="#1D4ED8" />
                                        </Border>
                                    </StackPanel>

                                    <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryBlueButton}" Height="30"
                                            Command="{Binding RefreshCrisisCommand}" ToolTip="Bu aşama için farklı bir kriz olasılığı getir">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="#1D4ED8" StrokeThickness="2" Margin="0,0,5,0"
                                                  Data="M4,12 A8,8 0 0,1 18,6.7 M20,12 A8,8 0 0,1 6,17.3 M15,4 H19 V8 M9,20 H5 V16" />
                                            <TextBlock Text="Yeni Olasılık" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="14.5" Foreground="#1D4ED8" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SelectedStage.TitleTr}" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="22.5" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                    <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.2"
                                            CornerRadius="8" Padding="9,3" VerticalAlignment="Center"
                                            Visibility="{Binding SelectedStage.HasMedal, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SelectedStage.MedalBadgeText}" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="14" Foreground="#B45309" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding SelectedStage.DescriptionTr}" FontSize="16" FontWeight="Medium"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21"
                                           Margin="0,0,0,10" />

                                <!-- O2 ve Basınç Telemetri Kutucukları -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                            CornerRadius="10" Padding="10,7">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="#2563EB" Margin="0,0,7,0"
                                                  Data="M12,3 C7,9 5,12.5 5,15.5 A7,7 0 0 0 19,15.5 C19,12.5 17,9 12,3 Z" />
                                            <TextBlock Text="OKSİJEN: " FontFamily="{StaticResource TechFont}" FontSize="15.5" Foreground="#64748B" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedStage.OxygenPercent, StringFormat='%{0}'}" FontFamily="{StaticResource TechFont}"
                                                       FontWeight="Bold" FontSize="17" Foreground="#0F172A" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                            CornerRadius="10" Padding="10,7">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="#2563EB" Margin="0,0,7,0"
                                                  Data="M12,3 A9,9 0 1 0 21,12 A9,9 0 0 0 12,3 Z M12,12 L16,8" />
                                            <TextBlock Text="BASINÇ: " FontFamily="{StaticResource TechFont}" FontSize="15.5" Foreground="#64748B" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedStage.PressureKpa, StringFormat='{}{0} kPa'}" FontFamily="{StaticResource TechFont}"
                                                       FontWeight="Bold" FontSize="17" Foreground="#0F172A" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Aksiyon Butonları: 1. Simülasyon Kokpiti + 2. Eğitim Modülü -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource PrimaryRedButton}" Height="46"
                                            Command="{Binding EnterMissionCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="SİMÜLASYONU BAŞLAT" FontFamily="{StaticResource HeadFont}"
                                                       FontWeight="Bold" FontSize="16.5" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <Path Style="{StaticResource IconPath}" Width="18" Height="18" Stroke="White" StrokeThickness="2"
                                                  Data="M12,2.5 C15.5,5.5 16.5,10 15,15 H9 C7.5,10 8.5,5.5 12,2.5 Z M9,15 L6,18.5 H9.5 M15,15 L18,18.5 H14.5" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource SecondaryBlueButton}" Height="46"
                                            Command="{Binding OpenStageTrainingCommand}" ToolTip="Bu aşamanın Akademi eğitim kartını aç">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="#1D4ED8" StrokeThickness="2" Margin="0,0,6,0"
                                                  Data="M4,5.5 C4,4.4 4.9,3.5 6,3.5 H18 C19.1,3.5 20,4.4 20,5.5 V18.5 C20,19.6 19.1,20.5 18,20.5 H6 C4.9,20.5 4,19.6 4,18.5 Z M8,8 H16 M8,12 H16 M8,16 H13" />
                                            <TextBlock Text="EĞİTİMİ AÇ" FontFamily="{StaticResource HeadFont}"
                                                       FontWeight="Bold" FontSize="16" Foreground="#1D4ED8" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- KART 2: ASTRONOT GELİŞİMİ & CANLI MADALYA SAYACI -->
                        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2"
                                CornerRadius="22" Padding="20,15" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="84" Height="84" VerticalAlignment="Center">
                                    <Ellipse Width="84" Height="84" Stroke="#E2E8F0" StrokeThickness="7" />
                                    <Path Stroke="#2563EB" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 42,4.5 A 37.5,37.5 0 1 1 8,57" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding XpProgressPercent, StringFormat='%{0:0}'}" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="17.5" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentXp, StringFormat='{}{0} XP'}" FontFamily="{StaticResource TechFont}"
                                                   FontSize="13.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressHeading}" FontFamily="{StaticResource TechFont}"
                                               FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource SubtleBrush}" />
                                    <TextBlock Text="{Binding LevelText}" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="20" Foreground="{StaticResource InkBrush}" Margin="0,1,0,6" />

                                    <!-- Canlı Altın / Gümüş / Bronz Madalya Rozetleri -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="10" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.3" Padding="9,4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding TotalGoldCount, StringFormat='★ {0} Altın'}" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="14.5" Foreground="#B45309" />
                                        </Border>
                                        <Border CornerRadius="10" Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1.3" Padding="9,4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding TotalSilverCount, StringFormat='★ {0} Gümüş'}" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="14.5" Foreground="#334155" />
                                        </Border>
                                        <Border CornerRadius="10" Background="#FFEDD5" BorderBrush="#EA580C" BorderThickness="1.3" Padding="9,4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding TotalBronzeCount, StringFormat='★ {0} Bronz'}" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="14.5" Foreground="#9A3412" />
                                        </Border>
                                        <Button Command="{Binding ShowMedalCelebrationCommand}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="6 Aşama Madalya Tablosunu Aç">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="10" Background="#EFF6FF" BorderBrush="#93C5FD"
                                                            BorderThickness="1.2" Padding="9,4">
                                                        <TextBlock Text="Tablo →" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                                                   FontSize="14" Foreground="#1D4ED8" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- KART 3: GÜNÜN MİNİ TESTİ (1 HAK, CEVAPLANINCA SEÇENEKLER GİZLENİR VE DOĞRU CEVAPLADINIZ GÖRÜNÜR) -->
                        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.2"
                                CornerRadius="22" Padding="20,16" Effect="{StaticResource CardShadow}">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding QuizHeading}" FontFamily="{StaticResource TechFont}"
                                               FontWeight="Bold" FontSize="16" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                                            CornerRadius="8" Padding="9,3">
                                        <TextBlock Text="1 HAK • +50 XP" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                                   FontSize="14.5" Foreground="#D97706" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding QuizQuestion}" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="Bold" FontSize="18.5" Foreground="{StaticResource InkBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,12" />

                                <!-- Seçenekler Sadece Cevaplanmadıysa Görünür (1 Kez Cevaplanınca Bir Daha Gözükmez) -->
                                <Grid Visibility="{Binding QuizAnswered, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource QuizOptionButton}"
                                            Content="{Binding QuizOptionA}"
                                            Command="{Binding AnswerQuizCommand}" CommandParameter="A" />
                                    <Button Grid.Column="2" Style="{StaticResource QuizOptionButton}"
                                            Content="{Binding QuizOptionB}"
                                            Command="{Binding AnswerQuizCommand}" CommandParameter="B" />
                                </Grid>

                                <!-- Cevaplandıktan Sonra Seçeneklerin Yerinde Çıkan Kutlama İbaresi -->
                                <StackPanel Visibility="{Binding QuizAnswered, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#DCFCE7" BorderBrush="#22C55E" BorderThickness="1.5"
                                            CornerRadius="14" Padding="16,12" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding QuizFeedback}"
                                                   FontFamily="{StaticResource HeadFont}" FontSize="17.5" FontWeight="Bold"
                                                   Foreground="#15803D" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2"
                                            CornerRadius="12" Padding="14,10">
                                        <TextBlock Text="BİLİMSEL NOT: Ay'ın yüzey kütleçekimi Dünya'nın 1/6'sıdır (1.62 m/s²). Günlük 1 soru hakkınız tamamlandı."
                                                   FontSize="15" FontWeight="SemiBold" Foreground="#475569" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 1B. ENTEGRE GÖREV & KRİZ SİMÜLASYONU KOKPİTİ (GÖREVE GİRİŞ YAPILDIĞINDA KOMUTA İÇİNDE AÇILIR) -->
                <Grid Visibility="{Binding IsStageCockpitActive, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- SOL PANEL: AŞAMA SEÇİCİ, 5 KAYNAK GÖSTERGESİ & EĞİTİM ÖZETİ -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                            CornerRadius="24" Padding="20,18" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Üst Dönüş & Yenile -->
                                <RowDefinition Height="Auto" /> <!-- 6 Aşama Hızlı Geçiş -->
                                <RowDefinition Height="Auto" /> <!-- 5 Kaynak Barları -->
                                <RowDefinition Height="*" />    <!-- Eğitim Brifingi Özeti -->
                            </Grid.RowDefinitions>

                            <!-- Üst Butonlar -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Button Style="{StaticResource SecondaryBlueButton}" Height="40" HorizontalAlignment="Left"
                                        Command="{Binding CloseStageCockpitCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="#1D4ED8" StrokeThickness="2.2" Margin="0,0,6,0"
                                              Data="M15,6 L9,12 L15,18" />
                                        <TextBlock Text="Yörünge Haritası" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryBlueButton}" Height="40" HorizontalAlignment="Right"
                                        Command="{Binding RefreshCrisisCommand}" ToolTip="Mevcut aşama için 4 olasılıktan farklı bir kriz sorusu getir">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Width="15" Height="15" Stroke="#1D4ED8" StrokeThickness="2" Margin="0,0,6,0"
                                              Data="M4,12 A8,8 0 0,1 18,6.7 M20,12 A8,8 0 0,1 6,17.3 M15,4 H19 V8 M9,20 H5 V16" />
                                        <TextBlock Text="Soruyu Yenile" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" Foreground="#1D4ED8" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 6 Aşama Seçici Şeridi (Tamamlanan ve Madalyalı Aşamaları Gösterir) -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="GÖREV AŞAMALARI (1 - 6)" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                               FontSize="15.5" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CompletedStagesCountText}" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                               FontSize="15" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Stages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectStageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" Margin="2,0"
                                                    ToolTip="{Binding TitleTr}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="stPill" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.4"
                                                                CornerRadius="10" Height="42">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock x:Name="stNum" Text="{Binding NumberBadge}"
                                                                           FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5"
                                                                           Foreground="#334155" HorizontalAlignment="Center" />
                                                                <TextBlock x:Name="stSub" Text="AÇIK" FontFamily="{StaticResource TechFont}"
                                                                           FontWeight="Bold" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsRoundCompleted}" Value="True">
                                                                <Setter TargetName="stPill" Property="Background" Value="#F0FDF4" />
                                                                <Setter TargetName="stPill" Property="BorderBrush" Value="#22C55E" />
                                                                <Setter TargetName="stNum" Property="Foreground" Value="#15803D" />
                                                                <Setter TargetName="stSub" Property="Text" Value="BİTTİ ✓" />
                                                                <Setter TargetName="stSub" Property="Foreground" Value="#16A34A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="stPill" Property="Background" Value="#2563EB" />
                                                                <Setter TargetName="stPill" Property="BorderBrush" Value="#1D4ED8" />
                                                                <Setter TargetName="stNum" Property="Foreground" Value="White" />
                                                                <Setter TargetName="stSub" Property="Foreground" Value="#DBEAFE" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 5'li Kaynak Yönetimi Göstergeleri -->
                            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2"
                                    CornerRadius="16" Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="YAŞAM DESTEK &amp; KAYNAK TELEMETRİSİ" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="15" Foreground="#475569" />
                                        <TextBlock Text="{Binding CurrentLocation.Name}" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="15" Foreground="#2563EB" HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Oksijen -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Oksijen (O2)" FontSize="15" FontWeight="SemiBold" Foreground="#334155" />
                                        <TextBlock Text="{Binding OxygenLevel, StringFormat='%{0:0}'}" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Value="{Binding OxygenLevel}" Maximum="100" Height="8" Foreground="{Binding OxygenStatusBrush}" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,8" />

                                    <!-- Enerji -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Batarya Enerjisi" FontSize="15" FontWeight="SemiBold" Foreground="#334155" />
                                        <TextBlock Text="{Binding EnergyLevel, StringFormat='%{0:0}'}" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Value="{Binding EnergyLevel}" Maximum="100" Height="8" Foreground="{Binding EnergyStatusBrush}" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,8" />

                                    <!-- Moral -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Mürettebat Morali" FontSize="15" FontWeight="SemiBold" Foreground="#334155" />
                                        <TextBlock Text="{Binding MoraleLevel, StringFormat='%{0:0}'}" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Value="{Binding MoraleLevel}" Maximum="100" Height="8" Foreground="#8B5CF6" Background="#E2E8F0" BorderThickness="0" Margin="0,0,0,8" />

                                    <!-- Bilgi & Zaman -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                            <StackPanel>
                                                <TextBlock Text="BİLGİ PUANI" FontFamily="{StaticResource TechFont}" FontSize="14" Foreground="#64748B" />
                                                <TextBlock Text="{Binding KnowledgeLevel, StringFormat='{}{0:0} Puan'}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="17" Foreground="#1D4ED8" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                            <StackPanel>
                                                <TextBlock Text="KALAN ZAMAN" FontFamily="{StaticResource TechFont}" FontSize="14" Foreground="#64748B" />
                                                <TextBlock Text="{Binding TimeLevel, StringFormat='%{0:0}'}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="17" Foreground="#0F172A" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Aşama Eğitim Özeti & Akademi Bağlantısı -->
                            <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.2"
                                    CornerRadius="16" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="AŞAMA EĞİTİM BRİFİNGİ" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="15" Foreground="#1D4ED8" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedStage.MedalBadgeText}"
                                                   Visibility="{Binding SelectedStage.HasMedal, Converter={StaticResource BoolToVis}}"
                                                   FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="14"
                                                   Foreground="#D97706" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="{Binding SelectedStage.TitleTr}" FontFamily="{StaticResource HeadFont}"
                                                   FontWeight="Bold" FontSize="18" Foreground="#0F172A" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedStage.DescriptionTr}" FontSize="15" Foreground="#334155"
                                                   TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                    <Button Grid.Row="2" Style="{StaticResource SecondaryBlueButton}" Height="38" Margin="0,8,0,0"
                                            Background="White" Command="{Binding OpenStageTrainingCommand}">
                                        <TextBlock Text="Bu Konuyu Akademi'de Detaylı Oku →" FontFamily="{StaticResource HeadFont}"
                                                   FontWeight="Bold" FontSize="15" Foreground="#1D4ED8" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- SAĞ PANEL: CANLI KRİZ SENARYOSU, 3 MÜHENDİSLİK KARARI VEYA KAZANILAN MADALYA PANELİ -->
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                            CornerRadius="24" Padding="24,20" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Kriz Kutusu -->
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />    <!-- 3 Karar Seçeneği VEYA Aşama Tamamlandı & Madalya Kartı -->
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" /> <!-- Alt Navigasyon & Öğrenme Günlüğü -->
                            </Grid.RowDefinitions>

                            <!-- 1. KRİZ UYARI KARTI -->
                            <Border Grid.Row="0" Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1.6"
                                    CornerRadius="18" Padding="18,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.2" Margin="0,0,10,0">
                                                <Path Style="{StaticResource IconPath}" Width="17" Height="17" Stroke="#D97706" StrokeThickness="2.2"
                                                      Data="M12,3 L22,20 H2 Z M12,9 V14 M12,17.5 V18" />
                                            </Border>
                                            <TextBlock Text="{Binding CurrentCrisisTitle, StringFormat='KRİZ DURUMU: {0}'}"
                                                       FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="19.5"
                                                       Foreground="#B45309" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                                                    CornerRadius="8" Padding="9,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentScenarioNumberText}" FontFamily="{StaticResource TechFont}"
                                                           FontWeight="Bold" FontSize="14.5" Foreground="#B45309" />
                                            </Border>

                                            <Button Style="{StaticResource SecondaryBlueButton}" Height="34" Margin="0,0,6,0"
                                                    Command="{Binding RefreshCrisisCommand}" ToolTip="4 olasılıktan farklı bir senaryo getir">
                                                <TextBlock Text="↻ Yenile" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="14.5" Foreground="#1D4ED8" />
                                            </Button>

                                            <Button Style="{StaticResource SecondaryBlueButton}" Height="34"
                                                    Command="{Binding ToggleHintCommand}">
                                                <TextBlock Text="İpucu" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="14.5" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding CurrentCrisisText}" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="21" Foreground="#78350F" TextWrapping="Wrap" Margin="0,2,0,6" />

                                    <TextBlock Text="{Binding EarthMessageText}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#92400E" TextWrapping="Wrap" />

                                    <!-- İpucu Kutusu -->
                                    <Border Visibility="{Binding IsHintVisible, Converter={StaticResource BoolToVis}}"
                                            Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.2"
                                            CornerRadius="12" Padding="12,8" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding HintText}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#1E3A8A" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 2A. 3 MÜHENDİSLİK KARAR SEÇENEĞİ (SEÇENEĞE TIKLANDIĞINDA ANINDA SONRAKİ AŞAMAYA GEÇER) -->
                            <Grid Grid.Row="2" Visibility="{Binding IsCurrentStageAnswered, Converter={StaticResource InverseBoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- KARAR A -->
                                <Button Grid.Row="0" Command="{Binding ExecuteDecisionACommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="decBd" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5"
                                                    CornerRadius="16" Padding="18,12">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" Background="#2563EB" Margin="0,0,14,0">
                                                        <TextBlock Text="A" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DecisionAText}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="18.5" Foreground="#1E3A8A" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DecisionACostText}" FontSize="15.5" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#DBEAFE" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                                        <TextBlock Text="UYGULA →" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="15" Foreground="#1D4ED8" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="decBd" Property="Background" Value="#DBEAFE" />
                                                    <Setter TargetName="decBd" Property="BorderBrush" Value="#2563EB" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- KARAR B -->
                                <Button Grid.Row="2" Command="{Binding ExecuteDecisionBCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="decBd" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5"
                                                    CornerRadius="16" Padding="18,12">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" Background="#EF4444" Margin="0,0,14,0">
                                                        <TextBlock Text="B" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DecisionBText}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="18.5" Foreground="#7F1D1D" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DecisionBCostText}" FontSize="15.5" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#FEE2E2" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                                        <TextBlock Text="UYGULA →" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="15" Foreground="#B91C1C" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="decBd" Property="Background" Value="#FEE2E2" />
                                                    <Setter TargetName="decBd" Property="BorderBrush" Value="#EF4444" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- KARAR C -->
                                <Button Grid.Row="4" Command="{Binding ExecuteDecisionCCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="decBd" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5"
                                                    CornerRadius="16" Padding="18,12">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" Background="#16A34A" Margin="0,0,14,0">
                                                        <TextBlock Text="C" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DecisionCText}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="18.5" Foreground="#14532D" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DecisionCCostText}" FontSize="15.5" FontWeight="SemiBold" Foreground="#15803D" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                                                        <TextBlock Text="UYGULA →" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="15" Foreground="#15803D" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="decBd" Property="Background" Value="#DCFCE7" />
                                                    <Setter TargetName="decBd" Property="BorderBrush" Value="#16A34A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- 2B. AŞAMA TAMAMLANDI & KAZANILAN MADALYA PANELİ (KARAR VERİLDİĞİNDE AÇILIR, TEKRAR BASILMASINI KİLİTLER) -->
                            <Border Grid.Row="2" Visibility="{Binding IsCurrentStageAnswered, Converter={StaticResource BoolToVis}}"
                                    Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="2"
                                    CornerRadius="20" Padding="24,18">
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Üst Madalya Başlığı -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="52" Height="52" CornerRadius="26" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="2" Margin="0,0,14,0">
                                            <Path Style="{StaticResource IconPath}" Width="26" Height="26" Stroke="#D97706" Fill="#F59E0B"
                                                  Data="M12,2.5 L14.6,8 L20.5,8.8 L16.2,13 L17.3,19 L12,16.2 L6.7,19 L7.8,13 L3.5,8.8 L9.4,8 Z" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="AŞAMA KARARI UYGULANDI • MADALYA KAZANIMI" FontFamily="{StaticResource TechFont}"
                                                       FontWeight="Bold" FontSize="15" Foreground="#15803D" />
                                            <TextBlock Text="{Binding LastBadgeResult}" FontFamily="{StaticResource HeadFont}"
                                                       FontWeight="Bold" FontSize="24" Foreground="#0F172A" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Madalya Açıklaması & Otomatik Geçiş Bilgisi -->
                                    <TextBlock Grid.Row="1" Text="{Binding LastBadgeMessage}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#166534" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <!-- NASA Gerçeği Kutusu -->
                                    <Border Grid.Row="2" Background="White" BorderBrush="#BBF7D0" BorderThickness="1.2"
                                            CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding JournalFact}" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding JournalDeltaSummary}" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Aksiyon Butonları: Farklı Olasılıkla Yenile veya Sonraki Aşamaya Geç -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryBlueButton}" Height="42" Margin="0,0,10,0"
                                                Command="{Binding RefreshCrisisCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="#1D4ED8" StrokeThickness="2" Margin="0,0,7,0"
                                                      Data="M4,12 A8,8 0 0,1 18,6.7 M20,12 A8,8 0 0,1 6,17.3 M15,4 H19 V8 M9,20 H5 V16" />
                                                <TextBlock Text="Farklı Olasılıkla Tekrar Çöz" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="16" Foreground="#1D4ED8" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource PrimaryRedButton}" Height="42" Margin="0,0,10,0"
                                                Visibility="{Binding HasNextStage, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding NextSimulationStageCommand}">
                                            <TextBlock Text="Sonraki Aşamaya Geç →" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                                        </Button>

                                        <Button Style="{StaticResource SecondaryBlueButton}" Height="42"
                                                Command="{Binding ShowMedalCelebrationCommand}">
                                            <TextBlock Text="★ 6 Madalya Tablosunu Gör" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" Foreground="#B45309" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3. ALT BÖLÜM: ÖĞRENME GÜNLÜĞÜ & AŞAMA KONTROLÜ -->
                            <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.3"
                                    CornerRadius="16" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding JournalFact}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#0F172A" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding JournalDeltaSummary}" FontSize="14.5" FontWeight="Medium"
                                                   Foreground="#475569" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Button Style="{StaticResource SecondaryBlueButton}" Height="38" Margin="0,0,8,0"
                                                Visibility="{Binding IsFailureDialogOpen, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding ResetSimulationCommand}">
                                            <TextBlock Text="Sıfırla &amp; Tekrar Dene" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15" />
                                        </Button>
                                        <Button Style="{StaticResource SecondaryBlueButton}" Height="38" Margin="0,0,8,0"
                                                Command="{Binding RefreshCrisisCommand}">
                                            <TextBlock Text="↻ Yeni Olasılık" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15" Foreground="#1D4ED8" />
                                        </Button>
                                        <Button Style="{StaticResource PrimaryRedButton}" Height="38"
                                                Visibility="{Binding HasNextStage, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding NextSimulationStageCommand}">
                                            <TextBlock Text="Sonraki Aşama →" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15" Foreground="White" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 1C. 6 AŞAMALI MADALYA TÖRENİ & PERFORMANS ÖZETİ MODAL EKRANI (6 SORU BİTTİĞİNDE 1'E DÖNMEZ, BU EKRANI AÇAR) -->
                <Grid Visibility="{Binding IsMedalCelebrationVisible, Converter={StaticResource BoolToVis}}"
                      Background="#B80F172A" Margin="-32,-26,-32,-26" Panel.ZIndex="90">
                    <Border MaxWidth="860" MaxHeight="650" Background="White" BorderBrush="#F59E0B" BorderThickness="2.5"
                            CornerRadius="28" Padding="32,26" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Başlık -->
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.4"
                                        CornerRadius="12" Padding="14,4" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="GÖREV YÖRÜNGESİ MADALYA KARNELERİ" FontFamily="{StaticResource TechFont}"
                                               FontWeight="Bold" FontSize="16" Foreground="#B45309" />
                                </Border>
                                <TextBlock Text="6 Aşamalı Astronot Görev Madalya Tablosu" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="Bold" FontSize="29" Foreground="#0F172A" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding MedalCelebrationSummary}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,2" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LeaderboardRankText}" FontFamily="{StaticResource TechFont}"
                                           FontWeight="Bold" FontSize="17" Foreground="#2563EB" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- 6 Aşama Madalya Yuvaları (3x2 UniformGrid) -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding CelebrationMedalSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" Rows="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5"
                                                CornerRadius="18" Padding="16,14" Margin="6" Effect="{StaticResource SoftShadow}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StageNumberText}" FontFamily="{StaticResource TechFont}"
                                                           FontWeight="Bold" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding StageTitle}" FontFamily="{StaticResource HeadFont}"
                                                           FontWeight="Bold" FontSize="18" Foreground="#0F172A"
                                                           HorizontalAlignment="Center" Margin="0,2,0,8" TextAlignment="Center" />

                                                <Border CornerRadius="12" Background="#FEF3C7" BorderBrush="#F59E0B"
                                                        BorderThickness="1.5" Padding="12,6" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource IconPath}" Width="18" Height="18" Stroke="#D97706" Fill="#F59E0B" Margin="0,0,6,0"
                                                              Data="M12,2.5 L14.6,8 L20.5,8.8 L16.2,13 L17.3,19 L12,16.2 L6.7,19 L7.8,13 L3.5,8.8 L9.4,8 Z" />
                                                        <TextBlock Text="{Binding MedalLabel}" FontFamily="{StaticResource HeadFont}"
                                                                   FontWeight="Bold" FontSize="15.5" Foreground="#B45309" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Alt Aksiyon Butonları -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PrimaryRedButton}" Height="46" Margin="0,0,12,0"
                                        Command="{Binding TekrarOynaCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Width="18" Height="18" Stroke="White" StrokeThickness="2" Margin="0,0,8,0"
                                              Data="M4,12 A8,8 0 0,1 18,6.7 M20,12 A8,8 0 0,1 6,17.3 M15,4 H19 V8 M9,20 H5 V16" />
                                        <TextBlock Text="Yeni Tur Başlat (Tüm Olasılıkları Yenile)" FontFamily="{StaticResource HeadFont}"
                                                   FontWeight="Bold" FontSize="16.5" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryBlueButton}" Height="46" Margin="0,0,12,0"
                                        Command="{Binding OpenKunyeFromCelebrationCommand}">
                                    <TextBlock Text="Künye &amp; Sıralamayı Aç →" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="16.5" Foreground="#1D4ED8" VerticalAlignment="Center" />
                                </Button>

                                <Button Style="{StaticResource SecondaryBlueButton}" Height="46"
                                        Command="{Binding CloseMedalCelebrationCommand}">
                                    <TextBlock Text="Kapat" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="16.5" Foreground="#475569" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================================================= -->
            <!-- ================= SEKME 2: AKADEMİ (İLK 5 EĞİTİM MODÜLÜ / BİLGİ KARTLARI) =============== -->
            <!-- ========================================================================================= -->
            <Grid Grid.Row="2" Visibility="{Binding IsAkademiTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SOL SÜTUN: 5 EĞİTİM MODÜLÜ LİSTESİ -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                        CornerRadius="24" Padding="20,18" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Başlık -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <Grid>
                                <TextBlock Text="ASTRONOT AKADEMİSİ" FontFamily="{StaticResource TechFont}" FontWeight="Bold"
                                           FontSize="16" Foreground="#2563EB" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                        CornerRadius="8" Padding="10,3">
                                    <TextBlock Text="{Binding ReadCardsCount, StringFormat='{}{0} / 5 Okundu'}"
                                               FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="15" Foreground="#1D4ED8" />
                                </Border>
                            </Grid>
                            <TextBlock Text="5 Temel Uzay Eğitim Modülü" FontFamily="{StaticResource HeadFont}" FontWeight="Bold"
                                       FontSize="23" Foreground="{StaticResource InkBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- 5 Eğitim Modülü Kart Listesi -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding InfoCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectInfoCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,8">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="cardBd" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"
                                                        CornerRadius="14" Padding="12,10">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border x:Name="numBox" Grid.Column="0" Width="42" Height="42" CornerRadius="10"
                                                                Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.2" Margin="0,0,12,0">
                                                            <TextBlock x:Name="numTxt" Text="{Binding NumberBadge}" FontFamily="{StaticResource HeadFont}"
                                                                       FontWeight="Bold" FontSize="18" Foreground="#1D4ED8"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StageTitle}" FontFamily="{StaticResource HeadFont}"
                                                                       FontWeight="Bold" FontSize="18" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="15" FontWeight="Medium"
                                                                       Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                        </StackPanel>

                                                        <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13"
                                                                Background="#DCFCE7" BorderBrush="#22C55E" BorderThickness="1"
                                                                Visibility="{Binding IsRead, Converter={StaticResource BoolToVis}}">
                                                            <Path Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="#15803D" StrokeThickness="2.4"
                                                                  Data="M5,12.5 L10,17.5 L19,7.5" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="cardBd" Property="Background" Value="#EFF6FF" />
                                                        <Setter TargetName="cardBd" Property="BorderBrush" Value="#2563EB" />
                                                        <Setter TargetName="numBox" Property="Background" Value="#2563EB" />
                                                        <Setter TargetName="numTxt" Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cardBd" Property="BorderBrush" Value="#60A5FA" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Alt Buton: Seçili Modülün Simülasyonunu Başlat -->
                        <Button Grid.Row="2" Style="{StaticResource PrimaryRedButton}" Height="48" Margin="0,6,0,0"
                                Command="{Binding LaunchCurrentCardSimulationCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="BU MODÜLÜN SİMÜLASYONUNU AÇ" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="Bold" FontSize="17" Foreground="White" Margin="0,0,8,0" />
                                <Path Style="{StaticResource IconPath}" Width="18" Height="18" Stroke="White" StrokeThickness="2.2"
                                      Data="M5,12 H19 M13,6 L19,12 L13,18" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- SAĞ SÜTUN: SEÇİLİ EĞİTİM KARTI DETAY OKUYUCU -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                        CornerRadius="24" Padding="32,26" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Üst Rozet & Vektör İllüstrasyon -->
                            <RowDefinition Height="Auto" /> <!-- Ana Başlık -->
                            <RowDefinition Height="*" />    <!-- Detaylı Eğitim Metni & Biliyor Muydun -->
                            <RowDefinition Height="Auto" /> <!-- Alt Kaynak & İleri/Geri Navigasyon -->
                        </Grid.RowDefinitions>

                        <!-- Üst Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="58" Height="58" CornerRadius="16" Background="#EFF6FF"
                                        BorderBrush="#93C5FD" BorderThickness="1.5" Margin="0,0,16,0">
                                    <Path Style="{StaticResource IconPath}" Width="30" Height="30" Stroke="#2563EB" StrokeThickness="2"
                                          Data="{Binding CurrentCard.VectorPathData}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentCard.StageTitle}" FontFamily="{StaticResource TechFont}"
                                               FontWeight="Bold" FontSize="18" Foreground="#2563EB" />
                                    <TextBlock Text="{Binding CurrentCard.Subtitle}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1.2"
                                    CornerRadius="10" Padding="14,6">
                                <TextBlock Text="NASA EĞİTİM ARŞİVİ • +25 XP" FontFamily="{StaticResource TechFont}"
                                           FontWeight="Bold" FontSize="15.5" Foreground="#15803D" />
                            </Border>
                        </Grid>

                        <!-- Ana Başlık -->
                        <TextBlock Grid.Row="1" Text="{Binding CurrentCard.MainTitle}"
                                   FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="27"
                                   Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- Açıklama ve Biliyor Muydun Kutusu -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Top">
                            <TextBlock Text="{Binding CurrentCard.Description}"
                                       FontSize="18.5" FontWeight="Medium" Foreground="#334155"
                                       TextWrapping="Wrap" LineHeight="27" Margin="0,0,0,18" />

                            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5"
                                    CornerRadius="18" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#2563EB"
                                            VerticalAlignment="Top" Margin="0,0,14,0">
                                        <Path Style="{StaticResource IconPath}" Width="24" Height="24" Stroke="White" StrokeThickness="2"
                                              Data="M12,2.5 L14.6,8 L20.5,8.8 L16.2,13 L17.3,19 L12,16.2 L6.7,19 L7.8,13 L3.5,8.8 L9.4,8 Z" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="BİLİYOR MUYDUN? — BİLİMSEL GERÇEK" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="16" Foreground="#1D4ED8" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding CurrentCard.DidYouKnow}" FontSize="17.5" FontWeight="SemiBold"
                                                   Foreground="#1E3A8A" TextWrapping="Wrap" LineHeight="24" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Alt Bar: Kaynak & Önceki/Sonraki Modül Butonları -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <TextBlock Text="{Binding CurrentCard.SourceText}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#64748B" VerticalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryBlueButton}" Height="46" Margin="0,0,10,0"
                                        IsEnabled="{Binding IsCardPrevEnabled}"
                                        Command="{Binding PrevCardCommand}">
                                    <TextBlock Text="← Önceki Modül" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="17" />
                                </Button>

                                <Button Style="{StaticResource PrimaryRedButton}" Height="46"
                                        Command="{Binding NextCardCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CardNextButtonText}" FontFamily="{StaticResource HeadFont}"
                                                   FontWeight="Bold" FontSize="17" Foreground="White" Margin="0,0,6,0" />
                                        <Path Style="{StaticResource IconPath}" Width="16" Height="16" Stroke="White" StrokeThickness="2.2"
                                              Data="M9,6 L15,12 L9,18" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================================= -->
            <!-- ================= SEKME 3: HANGAR (8 NASA SPACE PLACE OYUNU & WEBVIEW2) ================= -->
            <!-- ========================================================================================= -->
            <Grid Grid.Row="2" Visibility="{Binding IsHangarTab, Converter={StaticResource BoolToVis}}">

                <!-- 3A. OYUN GALERİSİ (8 NASA OYUNU KARTLARI) -->
                <Border Background="#B8FFFFFF" BorderBrush="White" BorderThickness="1.8"
                        CornerRadius="26" Padding="24,20" Effect="{StaticResource CardShadow}"
                        Visibility="{Binding IsPlayingGame, Converter={StaticResource InverseBoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="UZAY HANGARI &amp; SİMÜLASYON OYUNLARI" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="Bold" FontSize="26" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="NASA Space Place İnteraktif Görev ve Mühendislik Simülasyonları — 8 Oyun"
                                           FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EFF6FF"
                                    BorderBrush="#93C5FD" BorderThickness="1.2" CornerRadius="12" Padding="14,6">
                                <TextBlock Text="TAM EKRAN WEBGL SİMÜLATÖRÜ" FontFamily="{StaticResource TechFont}"
                                           FontWeight="Bold" FontSize="16" Foreground="#1D4ED8" />
                            </Border>
                        </Grid>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Games}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" Rows="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.3"
                                            CornerRadius="18" Margin="6" Padding="12" Effect="{StaticResource SoftShadow}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="92" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Oyun Görseli -->
                                            <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Background="#0F172A" Margin="0,0,0,8">
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <!-- Kategori & Başlık -->
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="{Binding Category}" FontFamily="{StaticResource TechFont}"
                                                           FontWeight="Bold" FontSize="14.5" Foreground="#2563EB" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TurkishTitle}" FontFamily="{StaticResource HeadFont}"
                                                           FontWeight="Bold" FontSize="17" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,4" />
                                            </StackPanel>

                                            <!-- Açıklama -->
                                            <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="14.5" Foreground="#475569"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" />

                                            <!-- Oyunu Başlat Butonu -->
                                            <Button Grid.Row="3" Style="{StaticResource PrimaryRedButton}" Height="38" Margin="0,8,0,0"
                                                    Command="{Binding DataContext.PlayGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="OYUNU BAŞLAT" FontFamily="{StaticResource HeadFont}"
                                                               FontWeight="Bold" FontSize="15.5" Foreground="White" Margin="0,0,6,0" />
                                                    <Path Style="{StaticResource IconPath}" Width="14" Height="14" Stroke="White" StrokeThickness="2.2"
                                                          Data="M8,5 L18,12 L8,19 Z" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- 3B. GÖMÜLÜ WEBVIEW2 OYUN EKRANI (OYUN BAŞLATILDIĞINDA HANGAR İÇİNDE AÇILIR) -->
                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5"
                        CornerRadius="24" ClipToBounds="True" Effect="{StaticResource CardShadow}"
                        Visibility="{Binding IsPlayingGame, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0F172A" Padding="18,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#2563EB" CornerRadius="8" Padding="10,4" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding SelectedGame.Category}" FontFamily="{StaticResource TechFont}"
                                                   FontWeight="Bold" FontSize="15.5" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedGame.TurkishTitle}" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="20" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>

                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="40"
                                        Style="{StaticResource PrimaryRedButton}"
                                        Command="{Binding StopGameCommand}">
                                    <TextBlock Text="← Hangara Dön (Oyunu Kapat)" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="16" Foreground="White" />
                                </Button>
                            </Grid>
                        </Border>

                        <wv2:WebView2 x:Name="GameWebView" Grid.Row="1" DefaultBackgroundColor="#070D1E" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================================= -->
            <!-- ================= SEKME 4: KÜNYE (ASTRONOT PROFİLİ, BECERİLER & SIRALAMA) =============== -->
            <!-- ========================================================================================= -->
            <Grid Grid.Row="2" Visibility="{Binding IsKunyeTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SOL SÜTUN: ASTRONOT KİMLİK KARTI & 6 KALICI BECERİ -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                        CornerRadius="24" Padding="22,20" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Kimlik Başlığı -->
                            <RowDefinition Height="Auto" /> <!-- 4 İstatistik Kutusu -->
                            <RowDefinition Height="*" />    <!-- 6 Astronot Becerisi -->
                        </Grid.RowDefinitions>

                        <!-- Kimlik Başlığı -->
                        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.4"
                                CornerRadius="18" Padding="16,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="White"
                                        BorderBrush="#2563EB" BorderThickness="2" Margin="0,0,14,0">
                                    <Path Style="{StaticResource IconPath}" Width="34" Height="34" Stroke="#2563EB" StrokeThickness="2"
                                          Data="M12,3 A8,8 0 0,1 20,11 V17 A2,2 0 0,1 18,19 H6 A2,2 0 0,1 4,17 V11 A8,8 0 0,1 12,3 Z M7.5,9.5 H16.5 V13.5 A2,2 0 0,1 14.5,15.5 H9.5 A2,2 0 0,1 7.5,13.5 Z" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Border Background="#2563EB" CornerRadius="6" Padding="8,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding RoleBadgeText}" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="14.5" Foreground="White" />
                                        </Border>
                                        <Border Background="White" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                            <TextBlock Text="{Binding RoundTitle}" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="14.5" Foreground="#1D4ED8" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AstronautFullName}" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="24" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding LevelText}" FontSize="16.5" FontWeight="SemiBold" Foreground="#475569" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 4 Performans İstatistiği -->
                        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,0,0,14">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="12,8" Margin="0,0,5,6">
                                <StackPanel>
                                    <TextBlock Text="TOPLAM GÖREV PUANI" FontFamily="{StaticResource TechFont}" FontSize="14" Foreground="#64748B" />
                                    <TextBlock Text="{Binding CurrentScore, StringFormat='{}{0} Puan'}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="20" Foreground="#0F172A" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="12,8" Margin="5,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="AKADEMİ SIRALAMASI" FontFamily="{StaticResource TechFont}" FontSize="14" Foreground="#64748B" />
                                    <TextBlock Text="{Binding PlayerRankText}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="20" Foreground="#2563EB" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="12,8" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="BİLGİ &amp; XP SEVİYESİ" FontFamily="{StaticResource TechFont}" FontSize="14" Foreground="#64748B" />
                                    <TextBlock Text="{Binding CurrentXp, StringFormat='{}{0} / 2500 XP'}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="19" Foreground="#16A34A" />
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="12,8" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="AKTİF GÖREV ÜSSÜ" FontFamily="{StaticResource TechFont}" FontSize="14" Foreground="#64748B" />
                                    <TextBlock Text="{Binding CurrentLocation.Name}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="18" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- 6 Kalıcı Astronot Becerisi -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="KAZANILAN KALICI ASTRONOT BECERİLERİ (6 YETENEK)"
                                       FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="15.5"
                                       Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,6" />
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Skills}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" Rows="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2"
                                                CornerRadius="12" Padding="10,7" Margin="3">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource HeadFont}"
                                                               FontWeight="Bold" FontSize="16" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                    <Border HorizontalAlignment="Right" Background="#DCFCE7" CornerRadius="5" Padding="6,1"
                                                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="AÇIK" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="12.5" Foreground="#15803D" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding EffectDesc}" FontSize="13.5" Foreground="#475569"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SAĞ SÜTUN: 6 AŞAMA MADALYA KOLEKSİYONU & CANLI LİDERLİK TABLOSU -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Üst Kart: 6 Aşama Madalya Koleksiyonu -->
                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                            CornerRadius="24" Padding="22,18" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="GÖREV MADALYA KOLEKSİYONU" FontFamily="{StaticResource TechFont}"
                                               FontWeight="Bold" FontSize="16" Foreground="{StaticResource SubtleBrush}" />
                                    <TextBlock Text="6 Aşamalı Eğitim ve Simülasyon Madalyaları" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="22" Foreground="{StaticResource InkBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.2" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding TotalGoldCount, StringFormat='Altın: {0}'}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="16.5" Foreground="#B45309" />
                                    </Border>
                                    <Border Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1.2" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding TotalSilverCount, StringFormat='Gümüş: {0}'}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="16.5" Foreground="#334155" />
                                    </Border>
                                    <Border Background="#FFEDD5" BorderBrush="#EA580C" BorderThickness="1.2" CornerRadius="10" Padding="10,4">
                                        <TextBlock Text="{Binding TotalBronzeCount, StringFormat='Bronz: {0}'}" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="16.5" Foreground="#9A3412" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding StageMedals}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding MedalBadgeBg}" BorderBrush="{Binding MedalBadgeBorder}"
                                                BorderThickness="1.4" CornerRadius="14" Padding="8,10" Margin="4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StageId, StringFormat='AŞAMA 0{0}'}" FontFamily="{StaticResource TechFont}"
                                                           FontWeight="Bold" FontSize="14.5" Foreground="#475569" HorizontalAlignment="Center" />
                                                <Path Style="{StaticResource IconPath}" Width="24" Height="24" Stroke="{Binding MedalBadgeFg}"
                                                      StrokeThickness="2" Margin="0,6" HorizontalAlignment="Center"
                                                      Data="M12,2.5 L14.6,8 L20.5,8.8 L16.2,13 L17.3,19 L12,16.2 L6.7,19 L7.8,13 L3.5,8.8 L9.4,8 Z" />
                                                <TextBlock Text="{Binding MedalBadgeText}" FontFamily="{StaticResource TechFont}"
                                                           FontWeight="Bold" FontSize="14.5" Foreground="{Binding MedalBadgeFg}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Alt Kart: Canlı Astronot Sıralaması (Leaderboard) -->
                    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                            CornerRadius="24" Padding="22,18" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="AKADEMİ LİDERLİK TABLOSU" FontFamily="{StaticResource TechFont}"
                                               FontWeight="Bold" FontSize="16" Foreground="{StaticResource SubtleBrush}" />
                                    <TextBlock Text="Astronot Adayları Başarı Sıralaması" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="22" Foreground="{StaticResource InkBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryBlueButton}" Height="36" Margin="0,0,6,0"
                                            Command="{Binding FilterLeaderboardCommand}" CommandParameter="madalya">
                                        <TextBlock Text="Madalya" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" />
                                    </Button>
                                    <Button Style="{StaticResource SecondaryBlueButton}" Height="36" Margin="0,0,6,0"
                                            Command="{Binding FilterLeaderboardCommand}" CommandParameter="bilgi">
                                        <TextBlock Text="Bilgi Puanı" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" />
                                    </Button>
                                    <Button Style="{StaticResource SecondaryBlueButton}" Height="36"
                                            Command="{Binding FilterLeaderboardCommand}" CommandParameter="hiz">
                                        <TextBlock Text="Kalan Zaman" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="15.5" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding LeaderboardScores}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2"
                                                CornerRadius="12" Padding="14,9" Margin="0,0,0,6">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#EFF6FF"
                                                        BorderBrush="#93C5FD" BorderThickness="1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Rank, StringFormat='#{0}'}" FontFamily="{StaticResource HeadFont}"
                                                               FontWeight="Bold" FontSize="16.5" Foreground="#1D4ED8"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource HeadFont}"
                                                               FontWeight="Bold" FontSize="18" Foreground="#0F172A" />
                                                    <TextBlock FontSize="15" Foreground="#64748B">
                                                        <Run Text="{Binding RoundLevel, Mode=OneWay, StringFormat='Tur {0}'}" />
                                                        <Run Text=" • " />
                                                        <Run Text="{Binding KnowledgeScore, Mode=OneWay, StringFormat='Bilgi: {0} P'}" />
                                                        <Run Text=" • " />
                                                        <Run Text="{Binding RemainingTime, Mode=OneWay, StringFormat='Zaman: %{0}'}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Border Background="#FEF3C7" CornerRadius="6" Padding="8,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding GoldCount, StringFormat='Altın: {0}'}" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="15" Foreground="#B45309" />
                                                    </Border>
                                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="8,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding SilverCount, StringFormat='Gümüş: {0}'}" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="15" Foreground="#334155" />
                                                    </Border>
                                                    <Border Background="#FFEDD5" CornerRadius="6" Padding="8,2">
                                                        <TextBlock Text="{Binding BronzeCount, StringFormat='Bronz: {0}'}" FontFamily="{StaticResource TechFont}" FontWeight="Bold" FontSize="15" Foreground="#9A3412" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding TotalScore, StringFormat='{}{0} Puan'}"
                                                           FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="18"
                                                           Foreground="#1D4ED8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================================================= -->
            <!-- ================= SEKME 5: AYARLAR (KONUM, SİSTEM, DONKI & OTURUM) ====================== -->
            <!-- ========================================================================================= -->
            <Grid Grid.Row="2" Visibility="{Binding IsAyarlarTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SOL KART: GÖREV ÜSSÜ, DİL VE SİMÜLASYON AYARLARI -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                        CornerRadius="24" Padding="26,22" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="GÖREV &amp; SİSTEM AYARLARI" FontFamily="{StaticResource TechFont}"
                                   FontWeight="Bold" FontSize="16.5" Foreground="#2563EB" />
                        <TextBlock Text="Simülasyon Konumu ve Tercihler" FontFamily="{StaticResource HeadFont}"
                                   FontWeight="Bold" FontSize="25" Foreground="{StaticResource InkBrush}" Margin="0,2,0,18" />

                        <!-- Görev Konumu Seçimi -->
                        <TextBlock Text="AKTİF GÖREV ÜSSÜ SEÇİMİ" FontFamily="{StaticResource TechFont}"
                                   FontWeight="Bold" FontSize="16" Foreground="#64748B" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryBlueButton}" Height="64"
                                    Command="{Binding SelectLocationCommand}" CommandParameter="Mars">
                                <StackPanel>
                                    <TextBlock Text="MARS — JEZERO KRATERİ" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" />
                                    <TextBlock Text="Perseverance Üssü • -63°C" FontSize="15" Foreground="#475569" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryBlueButton}" Height="64"
                                    Command="{Binding SelectLocationCommand}" CommandParameter="Moon">
                                <StackPanel>
                                    <TextBlock Text="AY — GÜNEY KUTBU" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" />
                                    <TextBlock Text="Shackleton Krateri • -130°C" FontSize="15" Foreground="#475569" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Dil Seçimi -->
                        <TextBlock Text="UYGULAMA DİLİ (LANGUAGE)" FontFamily="{StaticResource TechFont}"
                                   FontWeight="Bold" FontSize="16" Foreground="#64748B" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryBlueButton}" Height="48"
                                    Command="{Binding SetLanguageCommand}" CommandParameter="TR">
                                <TextBlock Text="Türkçe (TR)" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="17" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryBlueButton}" Height="48"
                                    Command="{Binding SetLanguageCommand}" CommandParameter="EN">
                                <TextBlock Text="English (EN)" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="17" />
                            </Button>
                        </Grid>

                        <!-- Görev Verilerini Yenile / Yeni Tur -->
                        <TextBlock Text="GÖREV &amp; TUR YÖNETİMİ" FontFamily="{StaticResource TechFont}"
                                   FontWeight="Bold" FontSize="16" Foreground="#64748B" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryBlueButton}" Height="48"
                                    Command="{Binding TumGorevleriYenileCommand}">
                                <TextBlock Text="Simülasyonu Sıfırla" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="16.5" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryBlueButton}" Height="48"
                                    Command="{Binding TekrarOynaCommand}">
                                <TextBlock Text="Yeni Tur (New Game+) Başlat" FontFamily="{StaticResource HeadFont}" FontWeight="Bold" FontSize="16.5" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SAĞ KART: CANLI NASA DONKI DURUMU, HAKKINDA & OTURUM KAPAT -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.4"
                        CornerRadius="24" Padding="26,22" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="CANLI TELEMETRİ &amp; OTURUM" FontFamily="{StaticResource TechFont}"
                                        FontWeight="Bold" FontSize="16.5" Foreground="#2563EB" />
                            <TextBlock Text="NASA DONKI Uzay Havası ve Hesap" FontFamily="{StaticResource HeadFont}"
                                       FontWeight="Bold" FontSize="25" Foreground="{StaticResource InkBrush}" Margin="0,2,0,16" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2"
                                    CornerRadius="16" Padding="16,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="CANLI UZAY HAVASI (NASA DONKI API)" FontFamily="{StaticResource TechFont}"
                                               FontWeight="Bold" FontSize="15.5" Foreground="#1D4ED8" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SolarActivityText}" FontFamily="{StaticResource HeadFont}"
                                               FontWeight="Bold" FontSize="20" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding DonkiSourceText}" FontSize="15.5" Foreground="#64748B" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.2"
                                    CornerRadius="16" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="ALTAY TUNGA DORA — GENÇ ASTRONOT AKADEMİSİ" FontFamily="{StaticResource TechFont}"
                                               FontWeight="Bold" FontSize="15.5" Foreground="#1D4ED8" Margin="0,0,0,4" />
                                    <TextBlock Text="Bu platform; 5 aşamalı NASA uzay eğitim modüllerini, 24 gerçekçi mühendislik kriz senaryosunu, canlı uzay havası telemetrisini ve 8 interaktif NASA Space Place simülasyon oyununu tek bir komuta merkezinde birleştirir."
                                               FontSize="16.5" Foreground="#334155" TextWrapping="Wrap" LineHeight="24" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource PrimaryRedButton}" Height="52"
                                Command="{Binding LogoutCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Width="20" Height="20" Stroke="White" StrokeThickness="2.2" Margin="0,0,8,0"
                                      Data="M9,21 H5 A2,2 0 0,1 3,19 V5 A2,2 0 0,1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9" />
                                <TextBlock Text="OTURUMU KAPAT (GİRİŞ EKRANINA DÖN)" FontFamily="{StaticResource HeadFont}"
                                           FontWeight="Bold" FontSize="17.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
